---
// Shared header for every page (marketing/SITE-NAV.md; one row since 2026-10-15 late, no status strip): RACKDENSITY wordmark → hub, Homelab Twin · DC Sim switcher,
// section menu + CTA in the section accent, Auto · Dark · Bright toggle. Phone: wordmark + switcher stay, the rest goes
// into one sheet (section menu, CTA, both products, the hub, the theme toggle). The language globe sits in the top-right
// corner at every width (Dali 2026-10-15) and opens English · Deutsch · 中文 (launched locales only).
// Self-contained styles: it runs on hub/homelab pages (styles/global.css) and on DC pages (styles/dc/global.css).
import { u } from '../lib/url';
import { BRAND } from '../config/brand';
import { MENU, CTA, PRODUCTS, type Section, type NavLink } from '../config/nav';
import ThemeToggle from './site/ThemeToggle.astro';
import { ui, fill, label, lp, switchHref, basePath, isLive, LOCALES, LOCALE_META, type Locale } from '../i18n';

interface Props { section?: Section; locale?: Locale }
const { section = 'hub', locale = 'en' } = Astro.props;
const t = ui(locale);
const path = Astro.url.pathname;
const enPath = basePath(path);
// Launched locales, plus the page's own (a locale under review is readable at its URL but not offered).
const langs = LOCALES.filter((l) => isLive(l) || l === locale);
const menu = MENU[section];
const cta = CTA[section];
const here = (l: NavLink) => !l.href.includes('#') && !l.download && path.startsWith(lp(l.href, locale));
const brandA = BRAND.slice(0, 4), brandB = BRAND.slice(4);
const current = PRODUCTS.find((p) => p.edition === section);
---
<a class="sh-skip" href="#main">{t.skip}</a>
<header class="site-header" data-section={section}>
  <div class="sh-wrap sh-bar">
    <a class="sh-logo" href={lp('/', locale)} aria-label={fill(t.allProducts, { brand: BRAND })}>
      <img class="only-dark" src={u('/brand/mark-rackdensity.svg')} alt="" width="24" height="24" />
      <img class="only-light" src={u('/brand/mark-rackdensity-print.svg')} alt="" width="24" height="24" />
      <span class="sh-wordmark">{brandA}<span>{brandB}</span></span>
    </a>
    <div class="sh-switch" role="group" aria-label={t.products}>
      {PRODUCTS.map((p) => (
        <a class:list={['sh-pill', `sh-pill--${p.edition}`, { 'is-current': p.edition === section }]} href={lp(p.href, locale)}
          aria-current={p.edition === section ? (path === lp(p.href, locale) ? 'page' : 'true') : undefined}>
          <span class="sh-led" aria-hidden="true"></span>{p.label}{'suffix' in p && p.suffix && <small> {p.suffix}</small>}
        </a>
      ))}
    </div>
    <nav class="sh-menu" aria-label={current ? fill(t.sectionMenu, { name: current.label }) : t.main}>
      {menu.map((l) => <a href={lp(l.href, locale)} aria-current={here(l) ? 'page' : undefined}>{label(locale, l.label)}</a>)}
    </nav>
    <span class="sh-spacer"></span>
    <span class="sh-theme-desk"><ThemeToggle compact locale={locale} /></span>
    {cta && <a class="sh-cta" href={lp(cta.href, locale)} download={cta.download ? '' : undefined}>{label(locale, cta.label)}</a>}
    <details class="sh-sheet">
      <summary aria-label={t.menu}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg><span>{t.menu}</span></summary>
      <div class="sh-panel">
        <p class="sh-h">{current ? current.label : BRAND}</p>
        {menu.map((l) => <a href={lp(l.href, locale)} aria-current={here(l) ? 'page' : undefined}>{label(locale, l.label)}</a>)}
        {cta && <a class="sh-panel-cta" href={lp(cta.href, locale)} download={cta.download ? '' : undefined}>{label(locale, cta.label)}</a>}
        <p class="sh-h">{t.products}</p>
        <div class="sh-switch sh-switch--sheet" role="group" aria-label={t.products}>
          {PRODUCTS.map((p) => (
            <a class:list={['sh-pill', `sh-pill--${p.edition}`, { 'is-current': p.edition === section }]} href={lp(p.href, locale)}>
              <span class="sh-led" aria-hidden="true"></span>{p.label}{'suffix' in p && p.suffix && <small> {p.suffix}</small>}
            </a>
          ))}
        </div>
        <a href={lp('/', locale)}>{fill(t.allProducts, { brand: BRAND })}</a>
        <p class="sh-h">{t.theme}</p>
        <ThemeToggle locale={locale} />
      </div>
    </details>
    {langs.length > 1 && (
      <details class="sh-lang">
        <summary aria-label={`${t.language}: ${LOCALE_META[locale].name}`} title={t.language}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></summary>
        <div class="sh-lang-list">{langs.map((l) => <a href={switchHref(enPath, l)} hreflang={LOCALE_META[l].hreflang} lang={LOCALE_META[l].html} data-lang={l} aria-current={l === locale ? 'true' : undefined}>{LOCALE_META[l].menu}</a>)}</div>
      </details>
    )}
  </div>
</header>
<style>
  .sh-skip { position: absolute; left: -999px; top: 0; z-index: 40; background: var(--accent); color: var(--on-accent); padding: 8px 12px; font-weight: 600; }
  .sh-skip:focus { left: 8px; top: 8px; }
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--glass); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .sh-wrap { max-width: var(--max, 1160px); margin: 0 auto; padding: 0 var(--gutter, 16px); }
  .sh-bar { display: flex; align-items: center; gap: 12px; min-height: 58px; position: relative; }
  .sh-logo { display: inline-flex; align-items: center; gap: 9px; color: var(--ink); text-decoration: none; flex: none; }
  .sh-wordmark { font: 600 .95rem/1 var(--font-mono); letter-spacing: .12em; }
  .sh-wordmark span { color: var(--accent); }

  /* Product switcher: the current product filled in its own accent, the other outlined; both outlined on the hub.
     Colours are the tokens' edition accents (dark: brand orange/green; bright: burnt orange/forest green). */
  .sh-switch { display: inline-flex; gap: 6px; flex: none; }
  .sh-pill { --pa: #e57000; --pon: #0b0a09; display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px; border: 1px solid var(--pa); border-radius: 999px; color: var(--ink); text-decoration: none; font: 500 12px/1 var(--font-mono); letter-spacing: .04em; white-space: nowrap; }
  .sh-pill--dc { --pa: #22c55e; --pon: #080a09; }
  :global([data-theme='light']) .sh-pill { --pa: #ad4a00; --pon: #ffffff; }
  :global([data-theme='light']) .sh-pill--dc { --pa: #137a34; }
  .sh-pill small { font-size: 10px; }
  .sh-led { width: 7px; height: 7px; border-radius: 50%; background: var(--pa); flex: none; }
  .sh-pill:hover { background: color-mix(in srgb, var(--pa) 14%, transparent); }
  .sh-pill.is-current { background: var(--pa); color: var(--pon); font-weight: 600; }
  .sh-pill.is-current .sh-led { background: var(--pon); }

  .sh-menu { display: none; gap: 2px; margin-left: 4px; }
  .sh-menu a { padding: 8px 9px; color: var(--ink-muted); text-decoration: none; font-size: .9rem; white-space: nowrap; }
  .sh-menu a:hover, .sh-menu a[aria-current='page'] { color: var(--ink); box-shadow: inset 0 -2px 0 var(--accent); }
  .sh-spacer { flex: 1; }
  .sh-theme-desk { display: none; }
  .sh-lang { position: relative; flex: none; }
  .sh-lang summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--line-strong); border-radius: var(--radius-1); color: var(--ink-muted); }
  .sh-lang summary::-webkit-details-marker { display: none; }
  .sh-lang summary:hover { color: var(--ink); background: var(--bg-200); }
  .sh-lang-list { position: absolute; right: 0; top: calc(100% + 4px); z-index: 30; display: grid; min-width: 140px; padding: 4px; background: var(--bg-100); border: 1px solid var(--line-strong); box-shadow: var(--shadow-panel); }
  .sh-lang-list a { padding: 10px 12px; color: var(--ink); text-decoration: none; font-size: .9rem; }
  .sh-lang-list a:hover { background: var(--accent-soft); }
  .sh-lang-list a[aria-current] { box-shadow: inset 2px 0 0 var(--accent); background: var(--accent-soft); }
  .sh-cta { display: none; align-items: center; min-height: 40px; padding: 0 14px; border-radius: var(--radius-1); background: var(--accent); color: var(--on-accent); font-weight: 600; font-size: .92rem; text-decoration: none; white-space: nowrap; }
  .sh-cta:hover { background: var(--accent-strong); color: var(--on-accent); }
  .site-header a:focus-visible, .site-header summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  :global(html[lang^='zh']) .sh-menu a, :global(html[lang^='zh']) .sh-cta { letter-spacing: .02em; }

  .sh-sheet summary { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 10px; border: 1px solid var(--line-strong); border-radius: var(--radius-1); color: var(--ink); font-size: .9rem; }
  .sh-sheet summary::-webkit-details-marker { display: none; }
  .sh-panel { position: absolute; top: calc(100% + 1px); left: var(--gutter, 16px); right: var(--gutter, 16px); background: var(--bg-100); border: 1px solid var(--line-strong); box-shadow: var(--shadow-panel); padding: 10px; display: grid; gap: 2px; max-height: calc(100vh - 80px); overflow: auto; }
  .sh-panel > a { display: block; padding: 11px 12px; color: var(--ink); text-decoration: none; }
  .sh-panel > a:hover, .sh-panel > a[aria-current='page'] { background: var(--accent-soft); }
  .sh-panel .sh-panel-cta { background: var(--accent); color: var(--on-accent); font-weight: 600; margin-top: 4px; }
  .sh-panel .sh-panel-cta:hover { background: var(--accent-strong); }
  .sh-h { margin: 10px 12px 4px; font: 600 11px/1 var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-dim); }
  .sh-h:first-child { margin-top: 4px; }
  .sh-switch--sheet { display: flex; flex-wrap: wrap; padding: 4px 12px 8px; }
  .sh-switch--sheet .sh-pill { height: 36px; font-size: 13px; }
  .sh-panel :global(.sh-theme) { margin: 2px 12px 6px; justify-self: start; }

  @media (min-width: 401px) and (max-width: 520px) { .sh-logo img { display: none !important; } }
  @media (max-width: 520px) {
    .sh-wordmark { font-size: .8rem; letter-spacing: .05em; }
    .sh-bar { gap: 8px; }
    .sh-bar > .sh-switch { gap: 4px; }
    .sh-bar > .sh-switch .sh-pill { padding: 0 8px; font-size: 11px; height: 28px; }
    .sh-bar > .sh-switch .sh-led { display: none; }
    .sh-sheet summary span { display: none; }
    .sh-sheet summary { min-width: 36px; padding: 0 8px; justify-content: center; }
    .sh-lang summary { width: 38px; }
  }
  /* Narrow phones: the mark replaces the wordmark so the globe keeps its corner (the link keeps its accessible name). */
  @media (max-width: 400px) { .sh-wordmark { display: none; } }
  @media (max-width: 359px) { .sh-bar > .sh-switch .sh-pill { padding: 0 6px; letter-spacing: 0; } }
  @media (max-width: 1239px) { .sh-bar > .sh-switch .sh-pill small { display: none; } }
  @media (min-width: 640px) { .sh-cta { display: inline-flex; } }
  /* 1180: the DC menu plus the globe fit from here (1100 overflowed by 68 px on /dc/). */
  @media (min-width: 1180px) {
    .sh-menu, .sh-theme-desk { display: inline-flex; }
    .sh-sheet { display: none; }
  }
</style>
<script>
  // The language you pick is kept for a year in the `lang` cookie, which overrides the by-country redirect
  // (functions/_middleware.ts, I18N.md §1). The language menu closes like the sheet.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang]').forEach((a) => a.addEventListener('click', () => {
    document.cookie = `lang=${a.dataset.lang}; Max-Age=31536000; Path=/; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
  }));
  const lang = document.querySelector<HTMLDetailsElement>('.sh-lang');
  if (lang) {
    document.addEventListener('click', (e) => { if (lang.open && !lang.contains(e.target as Node)) lang.open = false; });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lang.open) { lang.open = false; lang.querySelector('summary')?.focus(); } });
  }
  // Close the phone sheet on Escape, on an outside click, or when the viewport grows past the breakpoint.
  const sheet = document.querySelector<HTMLDetailsElement>('.sh-sheet');
  if (sheet) {
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet.open) { sheet.open = false; sheet.querySelector('summary')?.focus(); } });
    document.addEventListener('click', (e) => { if (sheet.open && !sheet.contains(e.target as Node)) sheet.open = false; });
    window.matchMedia('(min-width: 1180px)').addEventListener('change', (m) => { if (m.matches) sheet.open = false; });
  }
</script>
