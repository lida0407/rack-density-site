---
import { u } from '../lib/url';
import { BRAND, PRODUCT_NAME, DC_PRODUCT_NAME, PARTNER } from '../config/brand';
interface Props { section?: 'hub' | 'homelab' }
const { section = 'hub' } = Astro.props;
const path = Astro.url.pathname;
const links = section === 'homelab'
  ? [
      { href: '/homelab', label: PRODUCT_NAME, exact: true },
      { href: '/homelab/try', label: 'See it' },
      { href: '/homelab/learn', label: 'Learn' },
      { href: '/homelab/pricing', label: 'Pricing' },
      { href: '/homelab/changelog', label: 'Changelog' },
      { href: '/#calculator', label: 'Calculator' },
    ]
  : [
      { href: '/homelab', label: PRODUCT_NAME },
      { href: '/dc', label: DC_PRODUCT_NAME },
      { href: '/#calculator', label: 'Calculator' },
    ];
const here = (l: { href: string; exact?: boolean }) => (l.exact ? path === u(l.href) : !l.href.includes('#') && path.startsWith(u(l.href)));
---
<header class="site-header">
  <div class="cs-strip" aria-label="Status">
    <span class="cs-strip__brand"><span class="cs-shape cs-shape--live" aria-hidden="true"></span>RACK<b>DENSITY</b>{section === 'homelab' && <> / {PRODUCT_NAME.toUpperCase()}</>}</span>
    {section === 'homelab'
      ? <span class="cs-strip__item">Demo lab <strong>1.02 kW · €165/mo · UPS 18 min</strong></span>
      : <span class="cs-strip__item">{PRODUCT_NAME} · {DC_PRODUCT_NAME}</span>}
    <span class="cs-strip__item">Runs in your browser · no data leaves it</span>
    <span class="cs-strip__spacer"></span>
    <span class="cs-strip__item">by {PARTNER.name}</span>
  </div>
  <div class="wrap bar">
    <a class="logo" href={u('/')} aria-label={`${BRAND} home`}>
      <img class="only-dark" src={u('/brand/mark-rackdensity.svg')} alt="" width="24" height="24" />
      <img class="only-light" src={u('/brand/mark-rackdensity-print.svg')} alt="" width="24" height="24" />
      <span class="wordmark"><span>RACK</span><span class="acc">DENSITY</span></span>
    </a>
    <nav aria-label="Main">
      <details class="menu">
        <summary aria-label="Menu">Menu</summary>
        <ul>
          {links.map((l) => <li><a href={u(l.href)} aria-current={here(l) ? 'page' : undefined}>{l.label}</a></li>)}
        </ul>
      </details>
    </nav>
    <button type="button" class="theme-toggle" aria-label="Bright mode" aria-pressed="false" title="Bright mode">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </button>
    {section === 'homelab' && <a class="btn btn-primary btn-sm" href={u('/homelab/try')}>See it</a>}
  </div>
</header>
<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--glass); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .cs-strip { min-height: 32px; border-bottom: 1px solid var(--line); background: var(--bg-100); }
  .bar { display: flex; align-items: center; gap: 14px; min-height: 58px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; }
  .wordmark { font-family: var(--font-mono); font-weight: 600; letter-spacing: .12em; font-size: .95rem; }
  .wordmark .acc { color: var(--accent); }
  nav { margin-left: auto; }
  .btn-sm { min-height: 40px; padding: 0 14px; font-size: .92rem; white-space: nowrap; }
  .theme-toggle { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid var(--line-strong); border-radius: var(--radius-1); background: transparent; color: var(--ink-muted); cursor: pointer; }
  .theme-toggle:hover { color: var(--ink); background: var(--bg-200); }
  .theme-toggle .moon { display: none; }
  :global([data-theme="light"]) .theme-toggle .sun { display: none; }
  :global([data-theme="light"]) .theme-toggle .moon { display: block; }
  @media (max-width: 420px) { .wordmark { letter-spacing: .06em; font-size: .82rem; } .bar { gap: 8px; } .btn-sm { padding: 0 10px; } .cs-strip .cs-strip__item:nth-child(3) { display: none; } }
  .menu summary { list-style: none; cursor: pointer; color: var(--ink-muted); padding: 8px 10px; border: 1px solid var(--line-strong); border-radius: var(--radius-1); font-size: .9rem; min-height: 40px; display: flex; align-items: center; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul { list-style: none; margin: 0; padding: 8px; position: absolute; right: var(--gutter); left: var(--gutter); top: 94px; background: var(--bg-100); border: 1px solid var(--line-strong); border-radius: 0; display: grid; gap: 2px; }
  .menu a { display: block; padding: 11px 12px; color: var(--ink); text-decoration: none; }
  .menu a:hover, .menu a[aria-current='page'] { background: var(--accent-soft); }
  @media (min-width: 900px) {
    .menu summary { display: none; }
    .menu { display: block; }
    .menu ul { position: static; display: flex; gap: 4px; background: none; border: 0; padding: 0; }
    .menu a { padding: 8px 10px; color: var(--ink-muted); font-size: .92rem; }
    .menu a[aria-current='page'], .menu a:hover { color: var(--ink); background: none; box-shadow: inset 0 -2px 0 var(--accent); }
  }
</style>
<script>
  // Desktop: keep the nav <details> open so links are always visible.
  const m = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 900px)');
  const sync = () => { if (m) m.open = mq.matches; };
  sync(); mq.addEventListener('change', sync);
  // Bright mode: data-theme="light" on <html>, remembered per visitor (the head script applies it before paint).
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const show = () => btn?.setAttribute('aria-pressed', String(root.dataset.theme === 'light'));
  show();
  btn?.addEventListener('click', () => {
    const light = root.dataset.theme !== 'light';
    if (light) root.dataset.theme = 'light'; else delete root.dataset.theme;
    try { localStorage.setItem('rd.theme', light ? 'light' : 'dark'); } catch { /* storage unavailable */ }
    show();
  });
</script>
