---
// Console screenshot frame: mono caption bar (status LED + scene + "simulated data"), the image, optional caption.
// Pass `light` for a bright-mode variant (shown when <html data-theme="light">).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ui, type Locale } from '../i18n';
interface Props { src: ImageMetadata; light?: ImageMetadata; alt: string; label?: string; caption?: string; eager?: boolean; widths?: number[]; sizes?: string; locale?: Locale }
const t = ui(Astro.props.locale ?? 'en');
const { src, light, alt, label = t.demoLab, caption, eager = false, widths = [480, 800, 1200], sizes = '(min-width: 1160px) 1120px, 100vw' } = Astro.props;
const common = { widths, sizes, format: 'webp' as const, quality: 72, loading: eager ? 'eager' as const : 'lazy' as const, decoding: eager ? 'sync' as const : 'async' as const };
---
<figure class="shot">
  <div class="bar"><span class="cs-shape cs-shape--live" aria-hidden="true"></span><b>{label}</b><span>· {t.simulated}</span></div>
  <Image src={src} alt={alt} class={light ? 'only-dark' : undefined} fetchpriority={eager ? 'high' : 'auto'} {...common} />
  {light && <Image src={light} alt={alt} class="only-light" {...common} loading="lazy" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>
