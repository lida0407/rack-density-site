---
// Hero video with theme switching (marketing/SITE-THEME-VIDEO.md §2). Files come from the dev recordings via `npm run media`:
//   public/<dir>/<name>-dark.webm|.mp4, public/<dir>/<name>-bright.webm|.mp4, posters src/assets/video/<name>-dark|bright.jpg
// Dark theme plays the lights-off recording, bright plays the lit-room one; the poster is the base layer (LCP, no JS,
// reduced motion), the video fades in on top once it plays. Missing files → the stills passed in as props, nothing else.
// Reduced motion or data saver: poster only, with a Play button. Always a Pause button (moving content > 5 s). Pauses off-screen.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import fs from 'node:fs';
import nodePath from 'node:path';
import { u } from '../../lib/url';

interface Props {
  name: string;            // e.g. 'hero-homelab'
  dir: string;             // public dir, e.g. '/homelab/media'
  dark: ImageMetadata;     // still for the dark theme (used when there is no dark poster)
  light?: ImageMetadata;   // still for the bright theme
  alt: string;
  altLight?: string;
  widths?: number[];
  sizes?: string;
}
const { name, dir, dark, light, alt, altLight = alt, widths = [480, 800, 1280], sizes = '100vw' } = Astro.props;
const posters = import.meta.glob<{ default: ImageMetadata }>('/src/assets/video/*.jpg', { eager: true });
const has = (f: string) => fs.existsSync(nodePath.join(process.cwd(), 'public', dir, f));
const files = (mode: 'dark' | 'bright') => ({
  webm: has(`${name}-${mode}.webm`) ? u(`${dir}/${name}-${mode}.webm`) : '',
  mp4: has(`${name}-${mode}.mp4`) ? u(`${dir}/${name}-${mode}.mp4`) : '',
  poster: posters[`/src/assets/video/${name}-${mode}.jpg`]?.default,
});
const d = files('dark'), b = files('bright');
const hasVideo = !!(d.webm || d.mp4 || b.webm || b.mp4);
const posterDark = d.poster ?? dark;
const posterLight = b.poster ?? light ?? dark;
const img = { widths, sizes, format: 'webp' as const, quality: 72 };
const ratio = `${posterDark.width} / ${posterDark.height}`;
---
<div class="hv" style={`aspect-ratio:${ratio}`} data-video={hasVideo ? '' : undefined}
  data-dark-webm={d.webm} data-dark-mp4={d.mp4} data-bright-webm={b.webm} data-bright-mp4={b.mp4}>
  <Image src={posterDark} class="hv-img only-dark" alt={alt} loading="eager" decoding="async" {...img} />
  <Image src={posterLight} class="hv-img only-light" alt={altLight} loading="eager" decoding="async" {...img} />
  <script is:inline>(function (s) { var i = s.parentNode.querySelectorAll('.hv-img'), l = document.documentElement.dataset.theme === 'light'; i[l ? 1 : 0].fetchPriority = 'high'; i[l ? 0 : 1].fetchPriority = 'low'; })(document.currentScript);</script>
  {hasVideo && <video class="hv-video" muted loop playsinline preload="none" aria-hidden="true" tabindex="-1" disablepictureinpicture></video>}
  {hasVideo && (
    <button class="hv-btn" type="button" hidden aria-label="Pause the video">
      <svg class="i-pause" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
      <svg class="i-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M8 5l11 7-11 7z" fill="currentColor"/></svg>
      <span class="hv-btn-label">Pause</span>
    </button>
  )}
</div>
<style>
  .hv { position: relative; overflow: hidden; background: #000; }
  .hv :global(.hv-img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hv-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .4s ease; }
  .hv.is-playing .hv-video, .hv.is-paused .hv-video { opacity: 1; }
  .hv-btn { position: absolute; right: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 6px; min-height: 32px; padding: 0 10px; border: 1px solid rgba(255,255,255,.35); border-radius: var(--radius-1, 4px); background: rgba(0,0,0,.62); color: #fff; font: 600 11px/1 var(--font-mono); letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
  .hv-btn:hover { background: rgba(0,0,0,.8); }
  .hv-btn:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  .hv-btn .i-play { display: none; }
  .hv-btn[data-state='play'] .i-play { display: block; }
  .hv-btn[data-state='play'] .i-pause { display: none; }
  @media (prefers-reduced-motion: reduce) { .hv-video { transition: none; } }
</style>
<script>
  type Mode = 'dark' | 'bright';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  // Data saver / slow connection: poster + Play, like reduced motion (the loops are 6–10 MB).
  const conn = (navigator as any).connection;
  const lean = () => !!conn && (conn.saveData || /(^|-)2g$|^3g$/.test(conn.effectiveType ?? ''));
  const root = document.documentElement;
  document.querySelectorAll<HTMLElement>('.hv[data-video]').forEach((el) => {
    const v = el.querySelector<HTMLVideoElement>('.hv-video')!;
    const btn = el.querySelector<HTMLButtonElement>('.hv-btn')!;
    let userPaused = false, userPlayed = false, onScreen = true, current = '';
    const mode = (): Mode => (root.dataset.theme === 'light' ? 'bright' : 'dark');
    const setBtn = (playing: boolean) => {
      btn.dataset.state = playing ? 'pause' : 'play';
      btn.setAttribute('aria-label', playing ? 'Pause the video' : 'Play the video');
      btn.querySelector('.hv-btn-label')!.textContent = playing ? 'Pause' : 'Play';
    };
    const play = () => { v.play().then(() => setBtn(true)).catch(() => setBtn(false)); };
    const pick = () => {
      const m = mode();
      const webm = el.dataset[`${m}Webm`], mp4 = el.dataset[`${m}Mp4`];
      const src = webm && v.canPlayType('video/webm; codecs="vp9"') ? webm : mp4 || webm || '';
      if (src === current) return;
      current = src;
      el.classList.remove('is-playing', 'is-paused');
      if (!src) { v.pause(); v.removeAttribute('src'); v.load(); btn.hidden = true; return; }
      const t = v.currentTime;
      v.src = src;
      v.addEventListener('loadedmetadata', () => { if (t && t < v.duration) v.currentTime = t; }, { once: true });
      btn.hidden = false;
      if (reduce.matches || lean() || userPaused || !onScreen) { setBtn(false); v.preload = 'none'; } else play();
    };
    v.addEventListener('playing', () => { el.classList.add('is-playing'); el.classList.remove('is-paused'); });
    v.addEventListener('pause', () => { if (el.classList.contains('is-playing')) el.classList.add('is-paused'); });
    btn.addEventListener('click', () => {
      if (v.paused) { userPaused = false; userPlayed = true; play(); } else { userPaused = true; v.pause(); setBtn(false); }
    });
    new MutationObserver(pick).observe(root, { attributes: true, attributeFilter: ['data-theme'] });
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      if (!current || userPaused || ((reduce.matches || lean()) && !userPlayed)) return;
      if (onScreen) play(); else v.pause();
    }).observe(el);
    // Start after the page has loaded so the poster stays the LCP and the video never competes with it.
    const start = () => ('requestIdleCallback' in window ? (window as any).requestIdleCallback(pick, { timeout: 1500 }) : setTimeout(pick, 300));
    if (document.readyState === 'complete') start(); else window.addEventListener('load', start, { once: true });
  });
</script>
