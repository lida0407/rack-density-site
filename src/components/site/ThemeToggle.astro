---
// Auto · Dark · Bright, three small buttons (works in the header and in the phone sheet). Needs ThemeScript in <head>.
import { ui, type Locale } from '../../i18n';
interface Props { compact?: boolean; locale?: Locale }
const { compact = false, locale = 'en' } = Astro.props;
const t = ui(locale);
---
<div class:list={['sh-theme', { compact }]} role="group" aria-label={t.theme}>
  <button type="button" data-mode="auto" title={t.themeAutoTitle} aria-label={t.themeAutoAria}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"/></svg>{!compact && <span>{t.themeAuto}</span>}</button>
  <button type="button" data-mode="dark" title={t.themeDark} aria-label={t.themeDarkAria}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>{!compact && <span>{t.themeDark}</span>}</button>
  <button type="button" data-mode="light" title={t.themeBright} aria-label={t.themeBrightAria}><svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>{!compact && <span>{t.themeBright}</span>}</button>
</div>
<style>
  .sh-theme { display: inline-flex; border: 1px solid var(--line-strong); border-radius: var(--radius-1); overflow: hidden; }
  .sh-theme button { display: inline-flex; align-items: center; gap: 6px; height: 34px; min-width: 34px; padding: 0 8px; border: 0; background: transparent; color: var(--ink-muted); font: 500 12px/1 var(--font-mono); letter-spacing: .06em; cursor: pointer; }
  .sh-theme button + button { border-left: 1px solid var(--line-strong); }
  .sh-theme button:hover { color: var(--ink); background: var(--bg-200); }
  .sh-theme button[aria-pressed='true'] { color: var(--ink); background: var(--accent-soft); box-shadow: inset 0 -2px 0 var(--accent); }
  .sh-theme button:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
</style>
<script>
  const sync = () => {
    const m = (window as any).rdTheme?.mode?.() ?? 'auto';
    document.querySelectorAll<HTMLButtonElement>('.sh-theme button').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === m)));
  };
  document.querySelectorAll<HTMLButtonElement>('.sh-theme button').forEach((b) => b.addEventListener('click', () => { (window as any).rdTheme?.set?.(b.dataset.mode); sync(); }));
  sync();
</script>
