---
// Primary CTA for Homelab Twin. No public demo (Dali, 2026-10-15): "See it" → clips and stills; with `walkthrough`
// it also shows "Request a walkthrough" (mailto). When TRY.live turns on, `direct` links straight to the app.
import { mailto } from '../lib/url';
import { TRY } from '../config/brand';
import { ui, lp, walkMail, type Locale } from '../i18n';
interface Props { label?: string; direct?: boolean; walkthrough?: boolean; utm?: string; locale?: Locale }
const { direct = false, walkthrough = false, utm, locale = 'en' } = Astro.props;
const t = ui(locale), label = Astro.props.label ?? t.seeIt;
const appUrl = TRY.url + (utm ? `?utm_source=${utm}&utm_medium=site` : '');
---
{direct && TRY.live
  ? <a class="btn btn-primary" href={appUrl} rel="noopener">{label}</a>
  : <a class="btn btn-primary" href={lp('/homelab/try', locale)}>{label}</a>}
{walkthrough && <a class="btn btn-ghost" href={mailto(walkMail(locale).subject, walkMail(locale).body)}>{t.walkthrough}</a>}
