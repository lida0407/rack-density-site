---
import { u } from '../lib/url';
import { PRODUCT_NAME, DC_PRODUCT_NAME, PARTNER, CONTACT_EMAIL } from '../config/brand';
---
<footer class="site-footer">
  <div class="wrap cols">
    <div>
      <p class="brand"><strong class="wm">RACK<span>DENSITY</span></strong> by <a href={PARTNER.url} rel="noopener">{PARTNER.name}</a></p>
      <p class="muted">{PRODUCT_NAME} for the homelab · {DC_PRODUCT_NAME} for the data center.</p>
      <p><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></p>
      <p class="dim">© 2026 {PARTNER.name}</p>
    </div>
    <div>
      <p class="h">{PRODUCT_NAME}</p>
      <ul>
        <li><a href={u('/homelab')}>Overview</a></li>
        <li><a href={u('/homelab/try')}>See it</a></li>
        <li><a href={u('/homelab/pricing')}>Pricing</a></li>
        <li><a href={u('/homelab/learn')}>Learn</a></li>
        <li><a href={u('/homelab/changelog')}>Changelog</a></li>
      </ul>
    </div>
    <div>
      <p class="h">Free tools</p>
      <ul>
        <li><a href={u('/#calculator')}>Rack Density Calculator</a></li>
        <li><a href={u('/homelab/learn/tokens-per-watt')}>Tokens per Watt</a></li>
        <li><a href={u('/homelab/learn/homelab-power-calculator')}>Homelab Power Cost</a></li>
        <li><a href={u('/homelab/learn/10-inch-mini-rack-planner')}>10-inch Rack Planner</a></li>
      </ul>
    </div>
    <div>
      <p class="h">Site</p>
      <ul>
        <li><a href={u('/dc')}>{DC_PRODUCT_NAME}</a></li>
        <li><a href={u('/privacy')}>Privacy</a></li>
      </ul>
    </div>
  </div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--line); padding: 40px 0 56px; margin-top: 40px; background: var(--bg-100); font: 400 12px/1.7 var(--font-mono); }
  .cols { display: grid; gap: 24px; }
  @media (min-width: 760px) { .cols { grid-template-columns: 2fr 1fr 1fr 1fr; } }
  p { margin: 0 0 8px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  a { color: var(--ink-muted); text-decoration: none; }
  a:hover { color: var(--accent); }
  .h { color: var(--ink-dim); font-size: 11px; text-transform: uppercase; letter-spacing: .14em; margin-bottom: 10px; }
  .wm { font-size: 14px; letter-spacing: .12em; color: var(--ink); } .wm span { color: var(--accent); }
  .brand a, p > a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
  .dim { color: var(--ink-dim); }
</style>
