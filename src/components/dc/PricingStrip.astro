---
import { dcCopy, dcLp } from "../../i18n/dc";
import type { Locale } from "../../i18n";
interface Props { locale?: Locale }
const { locale = "en" } = Astro.props;
const { t } = dcCopy("components", locale);
---
<section class="section" aria-labelledby="ps-h">
  <span class="eyebrow">{t("pricingStrip.eyebrow")}</span>
  <h2 id="ps-h" style="margin-top:12px">{t("pricingStrip.h2")}</h2>
  <div class="grid grid-3 tiles">
    <div class="card"><h3>{t("pricingStrip.design.h3")}</h3><p class="price" set:html={t("pricingStrip.design.price")} /><p class="muted">{t("pricingStrip.design.p")}</p></div>
    <div class="card ps-rec"><h3>{t("pricingStrip.monitor.h3")}</h3><p class="price" set:html={t("pricingStrip.monitor.price")} /><p class="muted">{t("pricingStrip.monitor.p")}</p></div>
    <div class="card"><h3>{t("pricingStrip.partner.h3")}</h3><p class="price" set:html={t("pricingStrip.partner.price")} /><p class="muted">{t("pricingStrip.partner.p")}</p></div>
  </div>
  <p style="margin-top:14px"><a href={dcLp("pricing/", locale)}>{t("pricingStrip.compare")}</a></p>
</section>

<style>
  .ps-rec { box-shadow: inset 0 2px 0 var(--accent); }
  .tiles h3 { font: 600 11px/14px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  .tiles .ps-rec h3 { color: var(--accent); }
</style>
