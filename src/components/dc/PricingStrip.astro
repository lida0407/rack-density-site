---
import { PRICES } from "../../config/dc/product";
import { u } from "../../lib/dc/url";
---
<section class="section" aria-labelledby="ps-h">
  <span class="eyebrow">Pricing</span>
  <h2 id="ps-h" style="margin-top:12px">Pricing that fits a 10-rack room</h2>
  <div class="grid grid-3 tiles">
    <div class="card"><h3>Design</h3><p class="price">from ${PRICES.design[0].price} <small>per project, one-time</small></p><p class="muted">Plan a room or a new row; three months per project. The AI design assistant comes at no extra cost when it ships.</p></div>
    <div class="card ps-rec"><h3>Monitor</h3><p class="price">${PRICES.monitorPerRack} <small>per rack per month, min ${PRICES.monitorMin}</small></p><p class="muted">The twin of a running room, with what-if and reports.</p></div>
    <div class="card"><h3>Partner</h3><p class="price">{PRICES.partnerMargin} % <small>margin</small></p><p class="muted">For integrators, MSPs and consultants.</p></div>
  </div>
  <p style="margin-top:14px"><a href={u("pricing/")}>Compare with typical DCIM pricing</a></p>
</section>

<style>
  .ps-rec { box-shadow: inset 0 2px 0 var(--accent); }
  .tiles h3 { font: 600 11px/14px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  .tiles .ps-rec h3 { color: var(--accent); }
</style>
