---
import { TEMPLATE_FILE, EXAMPLE_FILE, mailto } from "../../config/dc/product";
import { u } from "../../lib/dc/url";
import { dcCopy, dcLp } from "../../i18n/dc";
import type { Locale } from "../../i18n";
interface Props { compact?: boolean; locale?: Locale }
const { compact = false, locale = "en" } = Astro.props;
const { t } = dcCopy("components", locale);
---
<section class="cta" aria-labelledby="cta-h">
  <h2 id="cta-h">{t("templateCta.h2")}</h2>
  {!compact && <p>{t("templateCta.p")}</p>}
  <div class="btn-row">
    <a class="btn btn-primary" href={u(TEMPLATE_FILE)} download>{t("templateCta.btnTemplate")}</a>
    <a class="btn btn-ghost" href={u(EXAMPLE_FILE)} download>{t("templateCta.btnExample")}</a>
    <a class="btn btn-ghost" href={mailto("DC Sim walkthrough", "Hi Da,\n\nI'd like a walkthrough of DC Sim with our own file.\n\nRacks: \nCompany: \n")}>{t("templateCta.btnWalkthrough")}</a>
  </div>
  <p class="small muted" style="margin:12px 0 0">{t("templateCta.fine")} <a href={dcLp("resources/excel-template/", locale)}>{t("templateCta.sheetsLink")}</a></p>
</section>
