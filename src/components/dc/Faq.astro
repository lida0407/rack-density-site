---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = "Questions people ask" } = Astro.props;
---
{items.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <span class="eyebrow" id="faq-h">{heading}</span>
    <div class="faq-list">
      {items.map((i, n) => (<details open={n === 0}><summary>{i.q}</summary><p>{i.a}</p></details>))}
    </div>
  </section>
)}
