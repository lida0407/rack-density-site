---
// Static map (equirectangular) for site and estate pages: land outline from public/dc/world/land.svg, pins and great-circle
// links drawn as inline SVG at build time. No script.
import { root } from "../../../lib/dc/url";
interface Pt { lat: number; lon: number; label?: string; hot?: boolean }
interface Ln { a: Pt; b: Pt; dashed?: boolean }
interface Props { points: Pt[]; links?: Ln[]; title: string; pad?: number }
const { points, links = [], title, pad = 30 } = Astro.props;
const W = 1000, H = 500;
const P = (p: { lat: number; lon: number }) => [((p.lon + 180) / 360) * W, ((90 - p.lat) / 180) * H];
const rad = Math.PI / 180;
const gc = (a: Pt, b: Pt, n = 48) => {
  const [la1, lo1, la2, lo2] = [a.lat * rad, a.lon * rad, b.lat * rad, b.lon * rad];
  const d = 2 * Math.asin(Math.sqrt(Math.sin((la2 - la1) / 2) ** 2 + Math.cos(la1) * Math.cos(la2) * Math.sin((lo2 - lo1) / 2) ** 2));
  if (d < 1e-9) return [P(a)];
  const out: number[][] = [];
  for (let i = 0; i <= n; i++) {
    const f = i / n, A = Math.sin((1 - f) * d) / Math.sin(d), B = Math.sin(f * d) / Math.sin(d);
    const x = A * Math.cos(la1) * Math.cos(lo1) + B * Math.cos(la2) * Math.cos(lo2), y = A * Math.cos(la1) * Math.sin(lo1) + B * Math.cos(la2) * Math.sin(lo2), z = A * Math.sin(la1) + B * Math.sin(la2);
    out.push(P({ lat: Math.atan2(z, Math.hypot(x, y)) / rad, lon: Math.atan2(y, x) / rad }));
  }
  return out;
};
const pathOf = (pts: number[][]) => pts.map((p, i) => `${i && Math.abs(p[0] - pts[i - 1][0]) < W / 2 ? "L" : "M"}${p[0].toFixed(1)},${p[1].toFixed(1)}`).join("");
const all = points.map(P);
let [x0, y0, x1, y1] = [Math.min(...all.map((p) => p[0])) - pad, Math.min(...all.map((p) => p[1])) - pad, Math.max(...all.map((p) => p[0])) + pad, Math.max(...all.map((p) => p[1])) + pad];
// keep 2:1, at least a 160 x 80 window, inside the map
let w = Math.max(x1 - x0, 160, (y1 - y0) * 2), h = w / 2;
const cx = (x0 + x1) / 2, cy = (y0 + y1) / 2;
x0 = Math.min(Math.max(cx - w / 2, 0), W - w); y0 = Math.min(Math.max(cy - h / 2, 0), H - h);
if (w > W) { x0 = 0; w = W; h = H; y0 = 0; }
const s = w / 1000;
---
<figure class="wmap">
  <svg viewBox={`${x0.toFixed(1)} ${y0.toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`} role="img" aria-label={title}>
    <image href={root("dc/world/land.svg")} x="0" y="0" width={W} height={H} preserveAspectRatio="none" />
    {links.map((l) => <path d={pathOf(gc(l.a, l.b))} fill="none" class:list={["wm-link", { dashed: l.dashed }]} stroke-width={2.2 * s} stroke-dasharray={l.dashed ? `${6 * s} ${4 * s}` : undefined} />)}
    {points.map((p) => { const [x, y] = P(p); return (<>
      <circle cx={x} cy={y} r={(p.hot ? 7 : 5) * s} class:list={["wm-pin", { hot: p.hot }]} stroke-width={1.5 * s} />
      {p.label && <text x={x + 9 * s} y={y + 4 * s} font-size={13 * s} class="wm-label">{p.label}</text>}
    </>); })}
  </svg>
  <figcaption><span>{title}</span><span class="sim">map: Natural Earth (public domain)</span></figcaption>
</figure>
<style>
  .wmap { margin: 0; border: 1px solid var(--line-strong); background: var(--bg-100); }
  .wmap svg { display: block; width: 100%; height: auto; aspect-ratio: 2 / 1; background: var(--bg-000); }
  .wm-link { stroke: var(--accent); stroke-opacity: 0.85; }
  .wm-link.dashed { stroke: var(--warn); }
  .wm-pin { fill: var(--accent); stroke: var(--bg-000); }
  .wm-pin.hot { fill: var(--accent); stroke: var(--ink); }
  .wm-label { fill: var(--ink); font-family: var(--font-mono); paint-order: stroke; stroke: var(--bg-000); stroke-width: 3px; }
  .wmap figcaption { display: flex; gap: 12px; flex-wrap: wrap; padding: 8px 12px; border-top: 1px solid var(--line); font: 500 12px/18px var(--font-mono); color: var(--ink-muted); }
  .wmap .sim { margin-left: auto; color: var(--ink-dim); }
</style>
