---
import { PRODUCT_NAME, TEMPLATE_FILE } from "../../config/dc/product";
import { PRODUCT_NAME as HOMELAB_NAME, BRAND, PARTNER } from "../../config/brand";
import { u, root } from "../../lib/dc/url";

const links = [
  { href: "product/", label: "Product" },
  { href: "integrations/", label: "Integrations" },
  { href: "partners/", label: "Partners" },
  { href: "pricing/", label: "Pricing" },
  { href: "resources/", label: "Resources" },
];
const here = Astro.url.pathname;
const isHere = (href: string) => here.startsWith(u(href));
const brandA = BRAND.slice(0, 4), brandB = BRAND.slice(4);
---
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <div class="cs-strip" aria-label="Status">
    <span class="cs-strip__brand"><span class="cs-shape cs-shape--live" aria-hidden="true"></span>{brandA}<b>{brandB}</b> / {PRODUCT_NAME.toUpperCase()}</span>
    <span class="cs-strip__item hide-sm">Demo hall <strong>IT 79.1 kW · PUE 1.16</strong></span>
    <span class="cs-strip__item hide-sm"><span class="cs-shape cs-shape--warn" aria-hidden="true"></span>Alarms <strong>2</strong></span>
    <span class="cs-strip__item hide-sm">Runs in the browser</span>
    <span class="cs-strip__spacer"></span>
    <span class="cs-strip__item">by {PARTNER.name}</span>
  </div>
  <div class="container bar">
    <a class="logo" href={root()} aria-label={`${BRAND} home`}>
      <img src={root("brand/mark-dc.svg")} alt="" width="24" height="24" />
      <span class="wordmark">{brandA}<span class="acc">{brandB}</span></span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href={root("homelab/")}>{HOMELAB_NAME}</a>
      <a href={u()} aria-current={here === u() ? "page" : undefined}>{PRODUCT_NAME}</a>
      {links.map((l) => <a href={u(l.href)} aria-current={isHere(l.href) ? "page" : undefined}>{l.label}</a>)}
      <a class="cs-btn cs-btn--primary" href={u(TEMPLATE_FILE)} download>Excel template</a>
    </nav>
    <details class="menu">
      <summary aria-label="Open menu">Menu</summary>
      <div class="menu-panel">
        <a href={u()}>{PRODUCT_NAME}</a>
        {links.map((l) => <a href={u(l.href)}>{l.label}</a>)}
        <a href={u("contact/")}>Contact</a>
        <a href={u(TEMPLATE_FILE)} download>Download the Excel template</a>
        <a href={root("homelab/")}>{HOMELAB_NAME}</a>
      </div>
    </details>
    <button type="button" class="theme-toggle" aria-label="Bright mode" aria-pressed="false" title="Bright mode">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>
<script>
  // Bright mode: data-theme="light" on <html>, remembered per visitor under the same key as the rest of the site.
  const rootEl = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const show = () => btn?.setAttribute("aria-pressed", String(rootEl.dataset.theme === "light"));
  show();
  btn?.addEventListener("click", () => {
    const light = rootEl.dataset.theme !== "light";
    if (light) rootEl.dataset.theme = "light"; else delete rootEl.dataset.theme;
    try { localStorage.setItem("rd.theme", light ? "light" : "dark"); } catch { /* storage unavailable */ }
    show();
  });
</script>
