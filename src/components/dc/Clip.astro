---
// A product clip: no autoplay, no preload (Lighthouse-friendly), optimised poster, burned-in captions in the video.
// Emits a VideoObject and a visible "What happens in this clip" transcript (SEO-GEO-PLAN §3) from config/dc/clips.ts.
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { u } from "../../lib/dc/url";
import { videoLd } from "../../lib/dc/schema";
import { CLIPS, isoDuration } from "../../config/dc/clips";
import { SITE_URL } from "../../../site.config.mjs";

interface Props { name: string; title: string; caption?: string }
const { name, title, caption } = Astro.props;
const posters = import.meta.glob<{ default: ImageMetadata }>("../../assets/dc/posters/*.png", { eager: true });
const src = posters[`../../assets/dc/posters/${name}.png`]?.default;
if (!src) throw new Error(`Unknown poster: ${name}`);
const poster = await getImage({ src, width: 1280, format: "webp", quality: 72 });
const meta = CLIPS[name];
const file = u(`media/dcsim-${name}.mp4`);
const ld = meta && JSON.stringify({
  "@context": "https://schema.org",
  ...videoLd({
    name: meta.title,
    description: caption ?? title,
    contentUrl: new URL(file, SITE_URL).href,
    thumbnailUrl: new URL(poster.src, SITE_URL).href,
    uploadDate: meta.uploadDate,
    duration: isoDuration(meta.seconds),
    transcript: meta.transcript.join(" "),
  }),
}).replace(/</g, "\\u003c");
---
<figure class="shot clip">
  <video controls muted playsinline preload="none" poster={poster.src} width="1920" height="1080" aria-label={title}>
    <source src={file} type="video/mp4" />
  </video>
  {caption && <figcaption><span class="cs-shape cs-shape--live" aria-hidden="true"></span><span>{caption}</span><span class="sim">recorded in the app</span></figcaption>}
  {meta && (
    <details class="clip-tx">
      <summary>What happens in this clip</summary>
      <ol>{meta.transcript.map((t) => <li>{t}</li>)}</ol>
    </details>
  )}
  {ld && <script type="application/ld+json" set:html={ld} />}
</figure>
<style>
  .clip video { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; background: #000; }
  .clip-tx { border-top: 1px solid var(--line); background: var(--bg-100); padding: 0 14px; font-size: 14px; line-height: 22px; color: var(--ink-muted); }
  .clip-tx summary { cursor: pointer; min-height: 40px; display: flex; align-items: center; font: 500 12px/16px var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-muted); }
  .clip-tx summary:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  .clip-tx ol { margin: 0 0 14px; padding-left: 20px; display: grid; gap: 6px; }
</style>
