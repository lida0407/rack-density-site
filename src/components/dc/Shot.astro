---
// One product still with its caption bar. `light` swaps in a lit-room still for the bright theme (lights-off shots stay dark-only).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { dcCopy } from "../../i18n/dc";
import type { Locale } from "../../i18n";

interface Still { name: string; alt: string; caption?: string }
interface Props extends Still { eager?: boolean; light?: Still; locale?: Locale }
const { name, alt, caption, eager = false, light, locale = "en" } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>("../../assets/dc/shots/*.png", { eager: true });
const load = (n: string) => {
  const img = files[`../../assets/dc/shots/${n}.png`]?.default;
  if (!img) throw new Error(`Unknown shot: ${n}`);
  return img;
};
const variants = [{ img: load(name), alt, caption, cls: light ? "only-dark" : undefined }];
if (light) variants.push({ img: load(light.name), alt: light.alt, caption: light.caption ?? caption, cls: "only-light" });
---
<figure class="shot">
  {variants.map((v, i) => {
    const tall = v.img.height > v.img.width;
    return (
      <Image
        class={v.cls}
        src={v.img}
        alt={v.alt}
        widths={tall ? [360, 720] : [480, 960, 1440]}
        sizes={tall ? "(max-width: 600px) 90vw, 360px" : "(max-width: 1120px) 100vw, 1088px"}
        format="webp"
        quality={78}
        loading={eager && i === 0 ? "eager" : "lazy"}
        fetchpriority={eager && i === 0 ? "high" : "auto"}
      />
    );
  })}
  {caption && (
    <figcaption>
      <span class="cs-shape cs-shape--live" aria-hidden="true"></span>
      {variants.map((v) => <span class={v.cls}>{v.caption}</span>)}
      <span class="sim">{dcCopy("page", locale).t("simulated")}</span>
    </figcaption>
  )}
</figure>
