---
// Shared electricity-price field. The page locale picks the starting currency and tariff (src/i18n/calc.ts, lib/prefs.ts).
import { ui, type Locale } from '../../i18n';
interface Props { label?: string; locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui(locale).price;
const label = Astro.props.label ?? t.label;
---
<div class="field">
  <span>{label}</span>
  <div style="display:flex; gap:8px">
    <select data-currency aria-label={t.currency} style="max-width:5.5em">
      <option value="€">€</option><option value="$">$</option><option value="£">£</option><option value="¥">¥</option>
    </select>
    <input data-price type="number" inputmode="decimal" min="0" step="0.01" value="0.30" aria-label={t.perKwh} />
  </div>
  <span class="hint">{t.hint}</span>
</div>
