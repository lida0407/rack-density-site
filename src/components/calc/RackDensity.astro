---
// Rack Density Calculator (/calculator/): form + result tiles on the left, the live RackDiagram on the right (sticky);
// phone: presets → inputs → tiles → diagram → message. ?preset=10|12|22|42 preselects; last inputs remembered locally.
import PriceField from './PriceField.astro';
import RackDiagram from './RackDiagram.astro';
import { DENSITY_PRESETS as presets } from '../../lib/calc/presets';
import { ui, fill, LOCALE_META, LOCALE_CALC, type Locale } from '../../i18n';
interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const t = ui(locale).density, d = ui(locale).diagram;
// 220 V / 380 V (mainland China) follow the EU and US circuits; each locale preselects its own (LOCALE_CALC.circuit).
const def = LOCALE_CALC[LOCALE_META[locale].html]?.circuit ?? 'single-230-16';
const circuits = ['single-230-16', 'single-230-10', 'single-120-15', 'single-120-20', 'three-400-16', 'three-400-32', 'single-220-16', 'single-220-10', 'three-380-16', 'three-380-32']
  .map((v) => { const [ph, V, A] = v.split('-'); return { v, label: `${ph === 'three' ? t.three : t.single} ${V} V · ${A} A` }; });
const uN = (n: number) => fill(t.uN, { n });
// Client strings for the result tiles and messages.
const T = { perMonth: t.perMonth, ok: t.ok, tight: t.tight, critical: t.critical, space: t.space, power: t.power, cooling: t.coolingW,
  msgCritical: t.msgCritical, msgWarn: t.msgWarn, msgOk: t.msgOk, unitU: t.unitU };
---
<div class="calc dens" data-calc="density" data-t={JSON.stringify(T)}>
 <div class="dens-main">
  <p class="small muted" style="margin:0 0 8px">{t.startFrom}</p>
  <div class="chips" style="margin-bottom:16px">
    {presets.map((p) => <button type="button" class="btn btn-ghost" style="min-height:40px" data-preset={JSON.stringify(p)} aria-pressed="false">{t.presets[p.id] ?? p.label}</button>)}
  </div>
  <p class="small muted" style="margin-top:-6px">{t.presetsNote}</p>
  <div class="calc-grid">
    <label class="field">{t.rackU} <input data-ru type="number" inputmode="decimal" min="1" value="42" /><span class="hint">{t.rackUHint}</span></label>
    <label class="field">{t.devU} <select data-su>{[1, 2, 3, 4].map((n) => <option value={n} selected={n === 2}>{uN(n)}</option>)}<option value="8">{t.devU8}</option></select></label>
    <label class="field">{t.watts} <input data-w type="number" inputmode="decimal" min="1" value="250" /><span class="hint">{t.wattsHint}</span></label>
    <label class="field">{t.cooling} <input data-cool type="number" inputmode="decimal" min="0.1" step="0.1" value="5" /><span class="hint">{t.coolingHint}</span></label>
    <label class="field">{t.circuit} <select data-circ>{circuits.map((c) => <option value={c.v} selected={c.v === def}>{c.label}</option>)}</select></label>
    <label class="field">{t.pf} <input data-pf type="number" inputmode="decimal" min="0.5" max="1" step="0.01" value="0.95" /></label>
    <PriceField locale={locale} />
  </div>
  <div class="results" aria-live="polite">
    <div class="result big"><div class="k">{t.perRack}</div><div class="v" data-o="n">–</div></div>
    <div class="result"><div class="k">{t.draw}</div><div class="v" data-o="kw">–</div></div>
    <div class="result"><div class="k">{t.cost247}</div><div class="v" data-o="cost">–</div></div>
    <div class="result"><div class="k">{t.status}</div><div class="v" data-o="st">–</div></div>
    <div class="result wide"><div class="k">{t.util}</div><ul class="util" data-o="util"><li>–</li></ul></div>
  </div>
 </div>
 <div class="dens-side"><RackDiagram locale={locale} /></div>
 <div class="dens-foot">
  <p data-o="msg" style="margin:14px 0 6px"></p>
  <p class="small muted" style="margin-top:10px">{t.foot}</p>
 </div>
</div>
<style>
  .dens { display: grid; gap: 0 24px; }
  .dens-main { margin-top: 16px; }
  .dens-side { margin: 18px 16px 0; }
  .dens .wide { grid-column: 1 / -1; }
  .util { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 2px; font: 500 .9rem/1.5 var(--font-mono); font-variant-numeric: tabular-nums; }
  @media (min-width: 960px) {
    .dens { grid-template-columns: 55fr 45fr; grid-template-areas: 'main side' 'foot side'; align-items: start; }
    .dens-main { grid-area: main; } .dens-foot { grid-area: foot; }
    .dens-side { grid-area: side; position: sticky; top: 76px; margin: 16px 16px 16px 0; }
  }
</style>
<script>
  import { rackDensity, type Phase } from '../../lib/calc/rackDensity';
  import { drawRack } from '../../lib/calc/rackDiagram';
  import { DENSITY_PRESETS } from '../../lib/calc/presets';
  import { bindPrice, num, fmt, money } from '../../lib/prefs';
  const KEY = 'rd.density';
  document.querySelectorAll<HTMLElement>('[data-calc="density"]').forEach((root) => {
    const q = (s: string) => root.querySelector(s) as HTMLInputElement;
    const T: Record<string, string> = JSON.parse(root.dataset.t!), fill = (s: string, v: Record<string, string>) => s.replace(/\{(\w+)\}/g, (_, k) => v[k] ?? '');
    const out = (k: string, v: string) => { (root.querySelector(`[data-o="${k}"]`) as HTMLElement).textContent = v; };
    let price: () => { currency: string; price: number };
    const fields = ['[data-ru]', '[data-su]', '[data-w]', '[data-cool]', '[data-circ]', '[data-pf]'];
    const run = () => {
      const [phase, volts, amps] = q('[data-circ]').value.split('-');
      try {
        const input = { rackU: num(q('[data-ru]')), serverU: num(q('[data-su]')), wattsPerServer: num(q('[data-w]')), coolingKw: num(q('[data-cool]')),
          supply: { phase: phase as Phase, volts: +volts, amps: +amps, pf: num(q('[data-pf]'), 0.95) } };
        const r = rackDensity(input);
        const p = price();
        const cost = money(p.currency, r.drawKw * 730 * p.price, 0);
        out('n', String(r.servers)); out('kw', `${fmt(r.drawKw, 2)} kW`);
        out('cost', `${cost} ${T.perMonth}`);
        out('st', r.status === 'ok' ? T.ok : r.status === 'warn' ? T.tight : T.critical);
        const pct = (v: number) => `${fmt(v * 100)} %`;
        root.querySelector('[data-o="util"]')!.replaceChildren(...[
          `${T.space} ${fmt(r.servers * input.serverU)} / ${fmt(input.rackU)} ${T.unitU} · ${pct(r.util.space)}`,
          `${T.power} ${fmt(r.drawKw, 2)} / ${fmt(r.supplyKw, 2)} kW · ${pct(r.util.power)}`,
          `${T.cooling} ${fmt(r.drawKw, 2)} / ${fmt(input.coolingKw, 2)} kW · ${pct(r.util.cooling)}`,
        ].map((t) => Object.assign(document.createElement('li'), { textContent: t })));
        const word = T[r.bottleneck];
        out('msg', fill(r.status === 'critical' ? T.msgCritical : r.status === 'warn' ? T.msgWarn : T.msgOk, { word }));
        drawRack(root.querySelector('[data-diagram]')!, r, input, cost);
        try { localStorage.setItem(KEY, JSON.stringify(fields.map((f) => q(f).value))); } catch { /* storage unavailable */ }
      } catch { out('n', '–'); }
    };
    const btns = [...root.querySelectorAll<HTMLButtonElement>('[data-preset]')];
    const apply = (p: (typeof DENSITY_PRESETS)[number]) => {
      q('[data-ru]').value = String(p.rackU); q('[data-su]').value = String(p.serverU); q('[data-w]').value = String(p.w); q('[data-cool]').value = String(p.cool);
      btns.forEach((b) => b.setAttribute('aria-pressed', String(JSON.parse(b.dataset.preset!).id === p.id)));
    };
    btns.forEach((b) => b.addEventListener('click', () => { apply(JSON.parse(b.dataset.preset!)); run(); }));
    // Start state: ?preset= wins, then the last inputs in this browser, then the defaults in the markup.
    const want = new URLSearchParams(location.search).get('preset');
    const preset = DENSITY_PRESETS.find((p) => p.id === want);
    if (preset) apply(preset);
    else try {
      const saved = JSON.parse(localStorage.getItem(KEY) ?? 'null');
      if (Array.isArray(saved) && saved.length === fields.length) fields.forEach((f, k) => { if (saved[k] !== '') q(f).value = String(saved[k]); });
    } catch { /* storage unavailable */ }
    price = bindPrice(root, run);
    root.addEventListener('input', (e) => { if ((e.target as Element).matches('[data-ru],[data-su],[data-w],[data-cool]')) btns.forEach((b) => b.setAttribute('aria-pressed', 'false')); run(); });
    root.addEventListener('change', run);
    run();
  });
</script>
