---
// Homelab Twin home — Console design (brand page canvas "Main"), adapted to: no public demo (See it + walkthrough),
// Pro $20/mo, product name from the constant. Numbers only from the dev logs (share/updatehl.md).
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Faq from '../../components/Faq.astro';
import TryButton from '../../components/TryButton.astro';
import HeroStage from '../../components/site/HeroStage.astro';
import Transcript from '../../components/site/Transcript.astro';
import { VIDEOS, videoLd } from '../../data/videos';
import { u, abs, notifyHref } from '../../lib/url';
import { PRODUCT_NAME, PRICES, FLAGS, WAITLIST } from '../../config/brand';
import { homeFaq } from '../../data/faq';
import heroDark from '../../assets/shots/hero-lightsoff.png';
import heroLight from '../../assets/shots/hero-office.png';
import overview from '../../assets/shots/overview.png';
import viewMenu from '../../assets/shots/view-menu.png';
import flaw from '../../assets/shots/flaw-finder.png';
import cables from '../../assets/shots/cables.png';
import ai from '../../assets/shots/ai.png';
import report from '../../assets/shots/import-report.png';

const app = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', '@id': abs('/homelab/') + '#app', name: PRODUCT_NAME,
  applicationCategory: 'UtilitiesApplication', operatingSystem: 'Web browser', url: abs('/homelab/'),
  description: 'A 3D model of your homelab rack built from an Excel or CSV file: power and cost per device (estimated), heat, network and cable views, power and network diagrams, a lights-off mode and a Fail what-if. The file is read in your browser and never uploaded.' };
const views = [
  { id: 'overview', label: 'Overview', img: overview, alt: 'The demo lab in 3D: two racks with labelled devices, a power and cost readout at the top and the timeline at the bottom', text: 'The whole lab at a glance: racks, devices, and the gear outside the rack. One readout on top: watts, cost per month, UPS runtime.' },
  { id: 'views', label: 'Views', img: viewMenu, alt: 'The View menu open over the demo lab, listing Overview, Power, Heat, Network, Cables, Compute and AI', text: 'Overview, Power, Heat, Network, Cables, Compute and AI sit in one View menu (keys 1–7). Power and Network switch between 3D and a diagram.' },
  { id: 'flaws', label: 'Flaw Finder', img: flaw, alt: 'Flaw Finder panel over the demo lab: the UPS is a single point of failure, with the devices that go dark and the fix', text: 'Single points of failure, overloaded strips, UPS runtime at peak and more, ranked with the fix. Try runs it once and opens the first issue.' },
  { id: 'cables', label: 'Cables · Pro', img: cables, alt: 'Cables view: power and network cables drawn at the back of both racks, with a cable count per device', text: 'Every cable at the rear of the rack, coloured by type and traced end to end through patch panels.' },
  { id: 'ai', label: 'AI · Pro', img: ai, alt: 'AI view: tokens per second per AI box, with tokens per kWh blurred as a Pro preview', text: 'Tokens per second for the AI box in your rack; tokens per kWh and cost per million tokens on Pro.' },
];
const checks = [
  ['crit', 'Two devices in the same U'], ['warn', 'A port used twice'], ['warn', '10G on a 1G port, or fiber into RJ45'],
  ['crit', 'Both power supplies on the same feed'], ['warn', 'A power strip over 80 % of its rating'], ['warn', 'UPS runtime under 5 minutes'],
  ['data', 'A cable shorter than its run'], ['data', 'Missing labels, undefined VLANs, port errors'],
];
const soon = !FLAGS.billingLive;
const heroImg = { widths: [480, 800, 1280], sizes: '(min-width: 1000px) 640px, 100vw' };
---
<Base title={`3D Homelab Rack Planner: Power, Cost & Cables | ${PRODUCT_NAME}`}
  description="Turn a spreadsheet of your gear into a 3D model of your homelab rack: watts, cost per month, network, and what goes dark when one thing fails."
  path="/homelab" ogImage="/homelab/og/home.png" schema={[app, videoLd(VIDEOS.hero, '/homelab')]} section="homelab">

  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">{PRODUCT_NAME} · 3D rack planner</p>
        <h1>Your homelab rack, in&nbsp;3D.</h1>
        <p class="lead">Drop in a spreadsheet of your gear. See what every device draws and costs, what's plugged where, and what goes dark when one thing fails.</p>
        <div class="btn-row"><TryButton walkthrough /></div>
        <p class="note"><span class="run"><span class="cs-shape cs-shape--off" aria-hidden="true"></span>Runs in your browser · no data leaves it</span>Try it free — coming when we open the doors; <a href={notifyHref('home')}>{WAITLIST.live ? 'join the waitlist' : 'get notified'}</a>. Your file is read in your browser and never uploaded.</p>
      </div>
      <HeroStage edition="homelab" label="Basement Lab" dark={heroDark} light={heroLight} sizes={heroImg.sizes}
        alt="The demo lab in 3D with the room lights off: device LEDs and screens glow, the readout shows 1.02 kW and €165 a month"
        altLight="The demo lab in 3D with the room lights on, in a bright office">
        <span slot="pin" class="cs-pin cs-pin--warn"><span class="cs-shape cs-shape--warn"></span>Disk 7 · SMART</span>
        <figcaption class="readouts"><span><span class="cs-shape cs-shape--warn"></span>16 issues found</span><span class="dim">demo · simulated data</span></figcaption>
        <div class="hero-tx"><Transcript video={VIDEOS.hero} label="What the hero clips show" /></div>
      </HeroStage>
    </div>
  </section>

  <section class="proof">
    <div class="wrap tiles tiles-3">
      <div class="tile"><p class="cs-eyebrow">Lights-out closet</p><p class="big">−145<small>W</small></p></div>
      <div class="tile"><p class="big2">−€34 <small>/ month</small></p><p class="muted">Room light off, rack still running. {PRODUCT_NAME} counts the light as a load like any other and shows the saving next to the watts. <span class="cs-badge cs-badge--estimated">estimated</span></p></div>
      <div class="tile cta"><a class="btn btn-ghost" href={u('/homelab/try#clips')}>Watch the lights go off</a></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">What it shows</p>
      <h2>What {PRODUCT_NAME} shows you</h2>
      <div class="tiles tiles-3 feats">
        <article class="tile"><span class="tag" style="color:var(--layer-power)">POWER</span><h3>What it costs</h3><p class="muted">Watts per device and money per month at your electricity price, estimated from each model and any readings you add. Follow the power from the wall through the UPS and power strip to every device, with the load on each step.</p><code>wall → UPS → power strip → device · load %</code></article>
        <article class="tile"><span class="tag" style="color:var(--layer-net)">NETWORK</span><h3>What's plugged where</h3><p class="muted">Router to switch to device, port by port, in 3D or as a clean diagram. On Pro, trace every cable at the back of the rack from end to end, through the patch panel.</p><code>ISP → router → switch → device · speed · PoE</code></article>
        <article class="tile"><span class="tag" style="color:var(--crit)">FAIL</span><h3>What goes dark</h3><p class="muted">Click the UPS, a power strip or a switch and press <strong>Fail</strong>. {PRODUCT_NAME} shows what loses power or network, and what keeps running. In every plan.</p><span class="cs-chip cs-chip--crit"><span class="cs-shape cs-shape--crit"></span>Fail → what goes dark</span></article>
      </div>
    </div>
  </section>

  <section class="section alt" id="how">
    <div class="wrap">
      <p class="eyebrow">How it works</p>
      <h2>From spreadsheet to 3D rack, in your browser.</h2>
      <ol class="steps tiles tiles-3">
        <li class="tile"><span class="num">01</span><h3>Get the template</h3><p class="muted">Or start from the Basement Lab example.</p></li>
        <li class="tile"><span class="num">02</span><h3>Fill in Devices</h3><p class="muted">Rack, U and model are the only required columns. Add cables, power and readings when you want more.</p></li>
        <li class="tile"><span class="num">03</span><h3>Drop the file in</h3><p class="muted">You get an import report and your rack in 3D. Unknown models still show up, as plain boxes of the right height.</p></li>
      </ol>
      <div class="btn-row" style="margin-top:18px">
        <a class="btn btn-ghost" href={u('/downloads/homelab-template.xlsx')} download>Download the template (.xlsx)</a>
        <a class="btn btn-ghost" href={u('/downloads/basement-lab.xlsx')} download>Download the Basement Lab example</a>
      </div>
      <p class="note">.xlsx, or one CSV per sheet. The file never leaves your machine.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2 two">
      <div>
        <p class="eyebrow">Views</p>
        <h2>One rack, seen several ways.</h2>
        <div class="viewtabs">
          {views.map((v, i) => <input type="radio" name="view" id={`v-${v.id}`} checked={i === 0} class="sr-only" />)}
          <div class="tablist" role="presentation">{views.map((v) => <label for={`v-${v.id}`} class="cs-chip">{v.label}</label>)}</div>
          {views.map((v) => <div class={`panel p-${v.id}`}><p class="muted">{v.text}</p><Shot src={v.img} alt={v.alt} label={v.label.replace(' · Pro', '')} sizes="(min-width: 1000px) 560px, 100vw" /></div>)}
        </div>
      </div>
      <div>
        <p class="eyebrow">Checks</p>
        <h2>It reads your sheet like a second pair of eyes.</h2>
        <p class="muted">Every import ends with a report: rows imported, rows skipped (with the reason), and checks pinned on the rack.</p>
        <ul class="checks">{checks.map(([k, t]) => <li><span class={`cs-shape cs-shape--${k}`}></span>{t}</li>)}</ul>
        <Shot src={report} alt="Import report of the template file: sheets imported, checks with errors, warnings and notes" label="Import report" sizes="(min-width: 1000px) 560px, 100vw" />
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap grid grid-2 two">
      <figure class="shot">
        <div class="bar"><span class="cs-shape cs-shape--live" aria-hidden="true"></span><b>Share · video</b><span>· simulated data</span></div>
        <video autoplay muted loop playsinline preload="none" poster={u('/homelab/media/lights-off-loop.jpg')} width="1280" height="654" aria-label="Animated share of the demo lab with the lights off: LEDs blink and power and network flows run between the racks">
          <source src={u('/homelab/media/lights-off-loop.webm')} type="video/webm" />
          <source src={u('/homelab/media/lights-off-loop.mp4')} type="video/mp4" />
        </video>
      </figure>
      <div>
        <p class="eyebrow">Share</p>
        <h2>Post your rack.</h2>
        <p class="muted">Every lab gets a ready-made share card (1200×630), a clean rack-elevation PNG, and an animated share: a short GIF for forums and a video of your rack with the LEDs blinking and the power and network flowing.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid grid-2 two">
      <div>
        <p class="eyebrow" style="color:var(--layer-ai)">AI</p>
        <h2>Tokens per kWh, for the AI box in your rack.</h2>
        <p class="muted">Tokens per second tells you how fast it is. Tokens per kWh tells you what it costs. {PRODUCT_NAME} puts both on the rack, next to the watts.</p>
        <p><a href={u('/homelab/learn/tokens-per-watt')}>Work out your tokens per watt with the free calculator →</a></p>
        <p class="note">The AI view's tokens per kWh is part of Pro. The calculator is free.</p>
      </div>
      <div class="tiles tiles-2 ai-tiles">
        <div class="tile"><span class="k">Tokens today</span><span class="v">719k</span><span class="note">Basement Lab · demo</span></div>
        <div class="tile"><span class="k">Tokens / kWh</span><span class="v blur" aria-hidden="true">495k</span><span class="cs-badge cs-badge--pro">Pro</span></div>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap">
      <div class="head-row"><div><p class="eyebrow">Pricing</p><h2>Free to try. Pay to keep it.</h2></div><a href={u('/homelab/pricing')}>Compare plans →</a></div>
      <div class="tiles tiles-3 prices">
        <div class="tile rec"><span class="k">Try</span><span class="p">Free</span><span class="muted">No account, nothing stored. Not public yet: see it or book a walkthrough.</span></div>
        <div class="tile"><span class="k">Account {soon && <span class="cs-badge cs-badge--roadmap">Launching soon</span>}</span><span class="p">${PRICES.account.month}<small> / month</small></span><span class="muted">or ${PRICES.account.year}/year. Keep your lab.</span></div>
        <div class="tile"><span class="k">Pro {soon && <span class="cs-badge cs-badge--roadmap">Launching soon</span>}</span><span class="p">${PRICES.pro.month}<small> / month</small></span><span class="muted">or ${PRICES.pro.year}/year. Cables, AI and the full toolkit.</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row"><div><p class="eyebrow">Learn</p><h2>Guides and free calculators</h2></div><a href={u('/homelab/learn')}>All guides →</a></div>
      <div class="grid grid-4 guides">
        <a class="card" href={u('/homelab/learn/homelab-power-calculator')}><span class="k">Guide · calculator</span><span class="t">Homelab power calculator: what your lab really costs</span><span class="muted">Monthly cost = average watts × 730 ÷ 1,000 × your price per kWh.</span></a>
        <a class="card" href={u('/homelab/learn/10-inch-mini-rack-planner')}><span class="k">Guide · planner</span><span class="t">10-inch mini rack planner: what fits and how to lay it out</span><span class="muted">A 254 mm panel, about 222 mm between the rails, 44.45 mm per U.</span></a>
        <a class="card" href={u('/homelab/learn/proxmox-power-usage')}><span class="k">Guide · calculator</span><span class="t">Proxmox power usage: measure it, then cut it</span><span class="muted">Measure at the wall or the UPS, then cut idle watts.</span></a>
        <a class="card" href={u('/homelab/learn/tokens-per-watt')}><span class="k">Guide · calculator</span><span class="t">Tokens per watt: how efficient is your local AI box?</span><span class="muted">Tokens per second ÷ watts = tokens per joule.</span></a>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap narrow">
      <p class="lead"><strong>Built by data-center people.</strong> {PRODUCT_NAME} comes from a team that builds 3D models of full data centers, scaled down to the rack in your basement. In partnership with <a href="https://sensaka.com" rel="noopener">Sensaka</a>.</p>
    </div>
  </section>

  <section class="section"><div class="wrap narrow"><Faq items={homeFaq} /></div></section>

  <section class="section final">
    <div class="wrap center">
      <h2>See your rack in 3D.</h2>
      <div class="btn-row" style="justify-content:center"><TryButton walkthrough /></div>
      <p class="note" style="margin-top:14px">No account = we store nothing. $5/month keeps it.</p>
    </div>
  </section>
</Base>
<style>
  .hero { padding: 40px 0 32px; background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px; background-position: -1px -1px; border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; gap: 28px; align-items: center; }
  @media (min-width: 1000px) { .hero-grid { grid-template-columns: 1fr 1.2fr; } .hero { padding: 64px 0 48px; } }
  .hero-copy { background: var(--bg-000); padding: 8px 0; }
  .note { font: 400 12px/18px var(--font-mono); color: var(--ink-dim); margin-top: 14px; }
  .note .run { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; color: var(--ink-muted); letter-spacing: .06em; text-transform: uppercase; font-size: 11px; }
  .readouts { display: flex; flex-wrap: wrap; gap: 6px 18px; font: 500 13px/18px var(--font-mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .readouts i { font-style: normal; color: var(--ink-muted); }
  .readouts span { display: inline-flex; align-items: center; gap: 6px; }
  .readouts .dim { color: var(--ink-dim); margin-left: auto; }
  .hero-tx { padding: 0 12px 8px; background: var(--bg-100); }
  .proof .tiles { margin-top: -1px; }
  .tile { background: var(--bg-100); padding: 24px 28px; display: flex; flex-direction: column; gap: 10px; justify-content: center; }
  .proof .tile { background: var(--bg-000); }
  .big { font: 600 clamp(56px, 8vw, 96px)/0.9 var(--font-mono); letter-spacing: -0.04em; color: var(--accent); text-shadow: 0 0 32px var(--accent-soft); margin: 0; }
  .big small, .big2 small { font-size: .4em; color: var(--ink-muted); letter-spacing: 0; text-shadow: none; margin-left: .1em; }
  .big2 { font: 600 clamp(32px, 4vw, 44px)/1 var(--font-mono); letter-spacing: -0.03em; margin: 0; }
  .cta { align-items: flex-start; }
  .feats { margin-top: 18px; }
  .feats .tag { font: 600 11px/14px var(--font-mono); letter-spacing: .14em; }
  .feats h3 { margin: 0; }
  .feats code { display: block; margin-top: auto; background: var(--bg-000); border: 1px solid var(--line); padding: 8px 10px; font-size: 12px; white-space: normal; }
  .alt { background: var(--bg-100); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .alt .tile { background: var(--bg-000); }
  .steps { list-style: none; padding: 0; margin: 18px 0 0; }
  .steps .num { font: 600 13px/1 var(--font-mono); color: var(--accent); }
  .steps h3 { margin: 0; }
  .two { gap: 48px; align-items: start; }
  .tablist { display: flex; flex-wrap: wrap; gap: 6px; margin: 14px 0; }
  .tablist label { cursor: pointer; height: 32px; }
  .panel { display: none; }
  #v-overview:checked ~ .p-overview, #v-views:checked ~ .p-views, #v-flaws:checked ~ .p-flaws, #v-cables:checked ~ .p-cables, #v-ai:checked ~ .p-ai { display: block; }
  #v-overview:checked ~ .tablist label[for='v-overview'], #v-views:checked ~ .tablist label[for='v-views'], #v-flaws:checked ~ .tablist label[for='v-flaws'],
  #v-cables:checked ~ .tablist label[for='v-cables'], #v-ai:checked ~ .tablist label[for='v-ai'] { color: var(--ink); border-color: var(--accent); background: var(--accent-soft); }
  #v-overview:focus-visible ~ .tablist label[for='v-overview'], #v-views:focus-visible ~ .tablist label[for='v-views'], #v-flaws:focus-visible ~ .tablist label[for='v-flaws'],
  #v-cables:focus-visible ~ .tablist label[for='v-cables'], #v-ai:focus-visible ~ .tablist label[for='v-ai'] { outline: 2px solid var(--focus); outline-offset: 2px; }
  .checks { list-style: none; padding: 0; margin: 14px 0 20px; display: grid; gap: 8px; }
  @media (min-width: 640px) { .checks { grid-template-columns: 1fr 1fr; } }
  .checks li { display: flex; align-items: center; gap: 10px; font-size: 15px; }
  video { width: 100%; height: auto; display: block; background: #000; }
  .ai-tiles .k, .prices .k, .guides .k { font: 600 11px/14px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .ai-tiles .v { font: 600 52px/1 var(--font-mono); letter-spacing: -0.03em; color: var(--layer-ai); }
  .ai-tiles .blur { filter: blur(10px); user-select: none; }
  .ai-tiles .cs-badge { align-self: flex-start; }
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .head-row h2 { margin: 0; }
  .prices .p { font: 600 44px/1 var(--font-mono); letter-spacing: -0.03em; }
  .prices .p small { font-size: 15px; color: var(--ink-muted); letter-spacing: 0; }
  .prices .rec { box-shadow: inset 0 3px 0 var(--accent); }
  .guides .card { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 8px; transition: border-color .15s; }
  .guides .card:hover { border-color: var(--accent); }
  .guides .t { font: 600 17px/23px var(--font-sans); }
  .final { border-top: 1px solid var(--line); }
</style>
