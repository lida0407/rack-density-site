---
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import SeeIn3D from '../../../components/SeeIn3D.astro';
import { getCollection, render } from 'astro:content';
import { u, abs } from '../../../lib/url';
import { BRAND, SITE_URL } from '../../../config/brand';

export async function getStaticPaths() {
  const all = await getCollection('learn');
  return all.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry, all } }));
}
const { entry, all } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/homelab/learn/${d.slug}`;
const iso = (x: Date) => x.toISOString().slice(0, 10);
const article = { '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.metaDescription, url: abs(path),
  datePublished: iso(d.date), dateModified: iso(d.updated), image: `${SITE_URL}${u(`/homelab/og/${d.slug}.png`)}`,
  author: { '@type': 'Organization', name: BRAND, url: abs('/') }, publisher: { '@id': `${abs('/')}#org` }, mainEntityOfPage: abs(path) };
const related = all.filter((e) => e.data.slug !== d.slug);
---
<Base title={d.metaTitle} description={d.metaDescription} path={path} ogImage={`/homelab/og/${d.slug}.png`} schema={[article]} section="homelab"
  crumbs={[{ name: 'Learn', path: '/homelab/learn' }, { name: d.title.split(':')[0] }]}>
  <article class="section-tight">
    <div class="wrap">
      <h1 class="narrow-h">{d.title}</h1>
      <p class="small muted">Updated <time datetime={iso(d.updated)}>{d.updated.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
      <div class="prose">
        <p class="answer">{d.answer}</p>
        <Content />
        <SeeIn3D title={d.cta.title} body={d.cta.body} button={d.cta.button} utm={d.slug} />
        <Faq items={d.faq.map((f) => ({ q: f.q, a: f.a }))} />
      </div>
      {related.length > 0 && <section style="margin-top:3em">
        <h2>More guides</h2>
        <div class="grid grid-3">{related.map((e) => <a class="card rel" href={u(`/homelab/learn/${e.data.slug}`)}><h3>{e.data.title}</h3><p class="muted small">{e.data.teaser}</p></a>)}</div>
      </section>}
    </div>
  </article>
</Base>
<style>
  .crumbs a { color: var(--muted); }
  .narrow-h { max-width: 22em; }
  .rel { text-decoration: none; color: var(--text); }
  .rel:hover { border-color: var(--accent); color: var(--text); }
</style>
