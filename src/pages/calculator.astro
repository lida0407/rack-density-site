---
// The calculator moved to the hub (/#calculator). Old links (/calculator/) land here and are sent on.
import { u, abs } from '../lib/url';
const to = u('/') + '#calculator';
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><title>Rack Density Calculator</title>
<meta name="robots" content="noindex" /><link rel="canonical" href={abs('/')} />
<meta http-equiv="refresh" content={`0; url=${to}`} /></head>
<body><p>The calculator is now on the <a href={to}>home page</a>.</p></body></html>
