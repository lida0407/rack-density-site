---
import { existsSync } from "node:fs";
import HeroStage from "../../components/site/HeroStage.astro";
// DC Sim home, from the approved page design (brand canvas "DcHome", Console, DC green).
import Base from "../../layouts/dc/Base.astro";
import Clip from "../../components/dc/Clip.astro";
import Faq from "../../components/dc/Faq.astro";
import ToolChips from "../../components/dc/ToolChips.astro";
import { PRODUCT_NAME, COMPANY, DEMO_URL, TEMPLATE_FILE, EXAMPLE_FILE, TEMPLATE_VERSION, PRICES, mailto } from "../../config/dc/product";
import { faqLd, softwareLd, videoLd } from "../../lib/dc/schema";
import { HERO_CLIP, isoDuration } from "../../config/dc/clips";
import { getImage } from "astro:assets";
import heroPoster from "../../assets/video/hero-dc-dark.jpg";
import { SITE_URL } from "../../../site.config.mjs";
import { u } from "../../lib/dc/url";
import heroDark from "../../assets/dc/shots/hero-lightsoff-crop.png";
import heroLight from "../../assets/dc/shots/hero-lit-crop.png";

const faq = [
  { q: `What is ${PRODUCT_NAME}?`, a: `A browser-based data center simulator by ${COMPANY}: one Excel import becomes a 3D twin with floor, air, water, fire, power, cabling, network, device and token layers, and any power, cooling or network node can be failed to see what goes dark.` },
  { q: "Can I sign up today?", a: "Not yet. The product runs today on demo data and on files you send us; we walk you through your own room on a call. Self-serve accounts and checkout are on the roadmap." },
  { q: "Do I have to install anything?", a: "No. The twin runs in the browser. Zabbix and NetBox connect with a URL and a read-only token; inside your own network the same connectors run in a small agent that only dials out. Any other tool's export comes in as a sheet." },
  { q: "Is this CFD?", a: "No. Air and water layers use a zonal model and every projected number is labelled estimated. It is built for questions like \"what happens if this cooling unit stops\", not for detailed airflow engineering." },
  { q: "How much does it cost?", a: "Monitor is about $5 per rack per month with a $49 minimum. Design is one-time per project from $490. Integrators and MSPs earn a 30 % margin as partners." },
  { q: "Is there a Chinese edition?", a: "Yes. The Chinese-language edition is distributed by our partner CloudSino." },
];
const walkthrough = DEMO_URL ?? mailto("DC Sim walkthrough", "Hi Da,\n\nI'd like a walkthrough of DC Sim with our own file.\n\nRacks: \nCompany: \n");
const sizes = "(min-width: 1200px) 600px, (min-width: 1000px) 50vw, 100vw";
const demoMoments = [
  { shape: "crit", text: "Lose feed A at peak: single-corded devices go dark and the other PDU overloads.", t: "0:31" },
  { shape: "warn", text: "A cooling unit stops: minutes to 27, 32 and 35 °C, estimated by a zonal model, not CFD.", t: "0:31" },
  { shape: "warn", text: "A manifold leaks: litres released (estimated), the valve isolates, tokens lost.", t: "0:31" },
  { shape: "data", text: "One Excel file in, the room in 3D, checks pinned, a change list on re-upload.", t: "0:48" },
];
const guides = [
  { href: "resources/guides/rack-power-capacity-planning/", title: "Rack power capacity planning with a spreadsheet and the 80 % rule", kind: "Guide · calculator" },
  { href: "resources/guides/ups-failure-impact-analysis/", title: "UPS failure impact analysis in 20 minutes", kind: "Guide" },
  { href: "resources/guides/tokens-per-kwh/", title: "Tokens per kWh: the one metric for an AI room", kind: "Guide · calculator" },
  { href: "resources/guides/dcim-for-small-data-center/", title: "DCIM for a small server room: what you need and what it should cost", kind: "Guide" },
];
// Hero (HERO-INTERACTIVE.md): HeroStage swaps recorded state clips (state-dc-<view>-<on|off>) under real controls once all
// ten are in public/dc/media/; until then it plays the 30 s loop (hero-dc-dark|bright), and the stills if that is missing too.
const views = ["overview", "power", "network", "cabling", "tokens"];
const stageLive = views.every((v) => ["on", "off"].every((l) => ["webm", "mp4"].some((e) => existsSync(`public/dc/media/state-dc-${v}-${l}.${e}`))));
const heroVideo = ["webm", "mp4"].some((e) => existsSync(`public/dc/media/hero-dc-dark.${e}`));
const heroThumb = await getImage({ src: heroPoster, width: 1280, format: "jpg", quality: 78 });
const heroLd = videoLd({
  name: HERO_CLIP.title,
  description: "A 30-second tour of DC Sim recorded from the app on the demo hall: the View menu, a UPS failure in the power chain, network utilisation, tokens per kWh and the lights-off view.",
  contentUrl: new URL(u("media/hero-dc-dark.mp4"), SITE_URL).href,
  thumbnailUrl: new URL(heroThumb.src, SITE_URL).href,
  uploadDate: HERO_CLIP.uploadDate,
  duration: isoDuration(HERO_CLIP.seconds),
  transcript: HERO_CLIP.transcript.join(" "),
});
---
<Base
  title={`${PRODUCT_NAME} — Your data center, simulated`}
  description="Turn one Excel file into a 3D twin of your data center. Fail any UPS, feed, switch or cooler and see what goes dark. Built to sit on top of the monitoring you run."
  path=""
  jsonLd={[softwareLd(), heroLd, ...faqLd(faq)]}
>
  <div class="dch">
    <section class="dch-hero">
      <div class="dch-wrap dch-hero-grid">
      <div class="dch-hero-copy">
        <span class="eyebrow">{PRODUCT_NAME} · by {COMPANY}</span>
        <h1>Your data center, simulated.</h1>
        <p class="lede">From a spreadsheet to a living 3D twin in minutes. Fail anything. See what goes dark.</p>
        <div class="btn-row">
          <a class="cs-btn cs-btn--primary dch-cta" href={u(TEMPLATE_FILE)} download>Download the Excel template</a>
          <a class="cs-btn cs-btn--secondary dch-cta" href={walkthrough}>{DEMO_URL ? "Open the demo" : "Request a walkthrough"}</a>
        </div>
        <p class="dch-note">Built by data-center people. Estimated where we estimate, labelled every time.</p>
      </div>
      <div class="dch-hero-fig">
        <HeroStage edition="dc" label="Demo hall" dark={heroDark} light={heroLight} sizes={sizes}
          alt="A data hall in DC Sim with the lights off: rows of racks glow green from their LEDs, the NOC wall screen lit."
          altLight="The same data hall with the lights on: white walls, light grey floor, rows of black racks, cooling units along the walls.">
          <span slot="pin" class="cs-pin"><span class="cs-shape cs-shape--live" aria-hidden="true"></span>{heroVideo ? "Recorded in the app" : <><span class="only-dark">Lights off</span><span class="only-light">Lights on</span></>}</span>
          <figcaption>{stageLive
            ? <span>Runs in the browser. Pick a view, switch the lights, fail UPS-A.</span>
            : heroVideo
              ? <span>Fail UPS-A, trace the network, count the tokens, turn the lights off.</span>
              : <><span class="only-dark">Lights off: what still glows is what is running.</span><span class="only-light">Lights on: the same hall, the same numbers.</span></>}<span class="sim">{heroVideo || stageLive ? "Demo hall" : "AI hall demo"} · simulated data</span></figcaption>
        </HeroStage>
      </div>
      </div>
    </section>

    <section class="dch-band">
      <div class="dch-wrap dch-proof">
        <div class="dch-stat"><span class="eyebrow dch-crit">Fail · UPS-A</span><div class="dch-big dch-crit">114<span>%</span></div><span class="dch-cap">PDU-R05-B at 113.9 % · 90 devices on one feed</span></div>
        <div class="dch-stat"><span class="eyebrow">Lights off</span><div class="dch-big dch-acc">−480<span> W</span></div><span class="dch-cap">−€53 / month · PUE 1.16 → 1.15</span></div>
        <p>Single-corded devices go dark and the other feed overloads. Every number comes from the demo hall's own spreadsheet, every projection is labelled <span class="cs-badge cs-badge--estimated">estimated</span></p>
      </div>
    </section>

    <section class="dch-wrap dch-sec dch-split">
      <div><span class="eyebrow">What it is</span><h2>One Excel file. Nine layers. Fail any node.</h2></div>
      <p class="dch-body">{PRODUCT_NAME} is a browser-based data center simulator. You import one Excel file with your racks, devices, power chain and cables, and get a 3D twin with floor, air, water, fire, power, cabling, network, device and token layers. Click any node, press Fail, and see which racks go dark and which services stop.</p>
    </section>

    <section class="dch-band2">
      <div class="dch-wrap dch-sec">
        <div class="dch-head"><span class="eyebrow">Three advantages</span><h2>Three things nobody else gives you</h2></div>
        <div class="dch-tiles">
          <article><span class="dch-num">01</span><h3>Design → Monitor in one tool</h3><p>Lay out the room before it exists, with U, weight, breaker and cooling checks as you go. Publish a version, import the as-built, keep the same model as the running twin.</p><span class="dch-foot">AI design assistant <span class="cs-badge cs-badge--roadmap">Roadmap</span> no extra cost</span></article>
          <article><span class="dch-num">02</span><h3>On top of the monitoring you run</h3><p>{PRODUCT_NAME} does not replace your monitoring or DCIM. Zabbix and NetBox connect with a URL and a read-only token: inventory, readings and alarms become the twin. Every other tool comes in as a sheet export.</p><span class="dch-foot"><span class="cs-chip cs-chip--ok"><span class="cs-shape cs-shape--ok" aria-hidden="true"></span>Zabbix · Available</span><span class="cs-chip cs-chip--ok"><span class="cs-shape cs-shape--ok" aria-hidden="true"></span>NetBox · Available</span></span></article>
          <article><span class="dch-num">03</span><h3>Device data that knows the hardware</h3><p>Type the model the way the vendor prints it, or pick it from the catalog. It fills in size, weight, power, airflow and the parts inside; a device the catalog does not know you describe once and reuse.</p><span class="dch-foot dch-mono">model → U · kg · W · airflow · parts</span></article>
        </div>
      </div>
    </section>

    <section class="dch-wrap dch-sec dch-split">
      <div>
        <div class="dch-head"><span class="eyebrow">How it works</span><h2>Fill, import, fail.</h2></div>
        <ol class="dch-steps">
          <li><span class="dch-num">01</span><div><h3>Fill one Excel file</h3><p>Devices is the only required sheet: rack, U and model per row. Cables, Racks, Power, Networks, Cooling and Readings each unlock another layer.</p></div></li>
          <li><span class="dch-num dch-dim">02</span><div><h3>Import</h3><p>Preview, a check list with 3D locations, apply. Re-upload later and see exactly what changed. Values only: formulas, macros and encrypted files are refused.</p></div></li>
          <li><span class="dch-num dch-dim">03</span><div><h3>Fail things first</h3><p>A scenario library built from your own model: feed loss, UPS, cooling, leak, fire, more load. Each run sits next to an untouched baseline.</p></div></li>
        </ol>
      </div>
      <div class="dch-moments">
        <span class="eyebrow">The demo moment</span>
        <ul>
          {demoMoments.map((m) => <li><span class={`cs-shape cs-shape--${m.shape}`} aria-hidden="true"></span><span>{m.text}</span><span class="dch-t">{m.t}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="dch-wrap dch-clips" aria-label="Clips">
      <div class="dch-clipgrid">
        <Clip name="feed-a-fails-lightsoff" title="Lose feed A at peak, lights off" caption="Lose feed A at peak (31 s)" />
        <Clip name="crah-stops" title="Cooling unit AC-1 stops" caption="AC-1 stops, minutes to threshold, estimated (31 s)" />
        <Clip name="leak" title="Manifold leak on a liquid-cooled GPU row" caption="A manifold leaks, tokens lost (31 s)" />
        <Clip name="excel-to-3d" title="From an Excel file to a 3D twin" caption="Excel to 3D, with a change list (48 s)" />
      </div>
    </section>

    <section class="dch-band2">
      <div class="dch-wrap dch-sec">
        <div class="dch-head"><span class="eyebrow">Who it is for</span><h2>Operators, integrators, AI rooms</h2></div>
        <div class="dch-who">
          <a class="cs-card" href={u("product/")}><span class="dch-kicker">1–50 racks</span><span class="dch-who-t">Operators</span><span class="dch-who-p">Server rooms, edge sites, colo cages, GPU rooms, universities, hospitals. See your room, find the single points of failure, plan the next row.</span><span class="dch-arrow">The product →</span></a>
          <a class="cs-card" href={u("partners/")}><span class="dch-kicker">Partners</span><span class="dch-who-t">Integrators and MSPs</span><span class="dch-who-p">Walk your customer through the data center before it exists, win the project, keep them on the twin after go-live.</span><span class="dch-arrow">Partner program →</span></a>
          <a class="cs-card" href={u("product/it/")}><span class="dch-kicker dch-ai">Tokens / kWh</span><span class="dch-who-t">AI infrastructure leads</span><span class="dch-who-p">Tokens per second per server, tokens per kWh per rack, and the tokens a failure would cost.</span><span class="dch-arrow">IT layers →</span></a>
        </div>
        <div class="dch-tools">
          <span class="dch-kicker">Works alongside your tools</span>
          <ToolChips />
          <p>● Available: connects directly. The others reach the twin today as an export through the template sheets. <a href={u("integrations/")}>Integration status, tool by tool →</a></p>
        </div>
      </div>
    </section>

    <section class="dch-wrap dch-sec">
      <div class="dch-rowhead"><div class="dch-head"><span class="eyebrow">Pricing</span><h2>Pricing that fits a 10-rack room</h2></div><a href={u("pricing/")}>Compare with typical DCIM pricing →</a></div>
      <div class="dch-prices">
        <div><span class="dch-kicker">Design</span><span class="dch-price">${PRICES.design[0].price}<span> from, per project</span></span><span class="dch-who-p">Plan a room or a new row; three months per project. The AI design assistant comes at no extra cost when it ships.</span></div>
        <div class="dch-rec"><span class="dch-kicker dch-acc">Monitor</span><span class="dch-price">${PRICES.monitorPerRack}<span> / rack / month · min ${PRICES.monitorMin}</span></span><span class="dch-who-p">The twin of a running room, with what-if and reports.</span></div>
        <div><span class="dch-kicker">Partner</span><span class="dch-price">{PRICES.partnerMargin} %<span> margin</span></span><span class="dch-who-p">For integrators, MSPs and consultants.</span></div>
      </div>
    </section>

    <section class="dch-band2">
      <div class="dch-wrap dch-sec dch-split">
        <Faq items={faq} />
        <div class="dch-res">
          <span class="eyebrow">Resources</span>
          {guides.map((g) => <a href={u(g.href)}><span>{g.title}</span><span class="dch-kicker">{g.kind}</span></a>)}
        </div>
      </div>
    </section>

    <section id="template" class="dch-wrap dch-sec dch-template">
      <span class="eyebrow">Excel template · v{TEMPLATE_VERSION}</span>
      <h2>One Excel file. Your room in 3D.</h2>
      <p>Download the import template (v{TEMPLATE_VERSION}, nine sheets, only Devices required) and the filled example from our demo hall. No form, no email needed, no macros in the files.</p>
      <div class="btn-row">
        <a class="cs-btn cs-btn--primary dch-cta" href={u(TEMPLATE_FILE)} download>Download the template (.xlsx)</a>
        <a class="cs-btn cs-btn--secondary dch-cta" href={u(EXAMPLE_FILE)} download>Download the filled example</a>
        <a class="cs-btn cs-btn--ghost dch-cta" href={walkthrough}>Request a walkthrough</a>
      </div>
    </section>
  </div>
</Base>
<style>
  .dch-wrap { max-width: 1200px; margin: 0 auto; padding-left: var(--gutter); padding-right: var(--gutter); }
  .dch-sec { padding-top: clamp(56px, 8vw, 96px); padding-bottom: clamp(56px, 8vw, 96px); }
  .dch h1 { margin: 0; font-size: clamp(40px, 6.2vw, 84px); line-height: 0.98; letter-spacing: -0.035em; max-width: 12em; }
  .dch h2 { margin: 0; font-size: clamp(28px, 3.2vw, 40px); }
  .dch h3 { margin: 0; }
  .dch-head { display: flex; flex-direction: column; gap: 12px; }
  .dch-hero { border-bottom: 1px solid var(--line); background: var(--bg-000); }
  /* Copy left, stage right from 1000 px (Dali 2026-10-15 late; HERO-INTERACTIVE §1, same grid as the homelab home) */
  .dch-hero-grid { display: grid; gap: 32px; align-items: center; padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(40px, 6vw, 64px); }
  @media (min-width: 1000px) { .dch-hero-grid { grid-template-columns: 1fr 1.2fr; gap: 48px; } .dch-hero h1 { font-size: clamp(44px, 4.6vw, 64px); } .dch-hero .lede { font-size: 18px; } }
  .dch-hero-copy { display: flex; flex-direction: column; gap: 22px; min-width: 0; }
  .dch-hero .lede { margin: 0; font-size: 19px; line-height: 28px; max-width: 36em; }
  .dch-cta { height: 44px; padding: 0 20px; font-size: 15px; }
  .dch-note { margin: 0; font: 400 12px/18px var(--font-mono); color: var(--ink-dim); }
  .dch-hero-fig { min-width: 0; }
  .dch-band { border-bottom: 1px solid var(--line); background: var(--bg-100); }
  .dch-band2 { border-block: 1px solid var(--line); background: var(--bg-100); }
  .dch-proof { padding-top: 32px; padding-bottom: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 24px 40px; align-items: end; }
  .dch-proof p { margin: 0; color: var(--ink-muted); line-height: 24px; }
  .dch-stat { display: flex; flex-direction: column; gap: 6px; }
  .dch-big { font: 600 clamp(48px, 6.4vw, 88px)/0.95 var(--font-mono); letter-spacing: -0.04em; white-space: nowrap; }
  .dch-big span { font-size: 0.45em; margin-left: 0.1em; }
  .dch-crit { color: var(--crit); }
  .dch-crit.eyebrow::before { background: var(--crit); }
  .dch-acc { color: var(--accent); }
  .dch-big.dch-acc { font-size: clamp(36px, 4.4vw, 60px); text-shadow: 0 0 28px var(--accent-soft); }
  .dch-big.dch-acc span { color: var(--ink-muted); text-shadow: none; }
  .dch-cap { font: 500 13px/18px var(--font-mono); color: var(--ink-muted); }
  .dch-split { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 48px; align-items: start; }
  .dch-split > * { min-width: 0; }
  .dch-body { margin: 0; color: var(--ink-muted); font-size: 17px; line-height: 28px; }
  .dch-tiles { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .dch-tiles article { background: var(--bg-000); padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .dch-tiles h3 { font-size: 20px; line-height: 26px; }
  .dch-tiles p { margin: 0; color: var(--ink-muted); line-height: 24px; font-size: 16px; }
  .dch-num { font: 600 13px/24px var(--font-mono); color: var(--accent); }
  .dch-dim { color: var(--ink-muted); }
  .dch-foot { margin-top: auto; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; font: 500 12px/18px var(--font-mono); color: var(--ink-muted); }
  .dch-mono { color: var(--ink); }
  .dch-steps { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 20px; }
  .dch-steps li { display: grid; grid-template-columns: 40px 1fr; gap: 12px; }
  .dch-steps h3 { font-size: 18px; line-height: 24px; margin-bottom: 6px; }
  .dch-steps p { margin: 0; color: var(--ink-muted); line-height: 24px; font-size: 16px; }
  .dch-moments { display: flex; flex-direction: column; gap: 16px; }
  .dch-moments ul { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); background: var(--bg-100); }
  .dch-moments li { display: grid; grid-template-columns: 16px 1fr auto; gap: 12px; align-items: baseline; padding: 14px 16px; border-bottom: 1px solid var(--line); line-height: 22px; font-size: 16px; }
  .dch-moments li:last-child { border-bottom: 0; }
  .dch-t { font: 500 12px/1 var(--font-mono); color: var(--ink-dim); }
  .dch-clips { padding-bottom: clamp(56px, 8vw, 96px); }
  .dch-clipgrid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 24px; }
  .dch-who { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 24px; }
  .dch-who .cs-card { text-decoration: none; color: var(--ink); background: var(--bg-000); }
  .dch-kicker { font: 600 11px/14px var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-muted); }
  .dch-ai { color: var(--layer-ai); }
  .dch-who-t { font: 600 18px/24px 'Inter Variable', var(--font-sans); }
  .dch-who-p { color: var(--ink-muted); line-height: 22px; font-size: 15px; }
  .dch-arrow { color: var(--accent); font-size: 14px; }
  .dch-tools { margin-top: 32px; display: flex; flex-direction: column; gap: 12px; }
  .dch-tools p { margin: 0; color: var(--ink-muted); font-size: 14px; }
  .dch-rowhead { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; }
  .dch-prices { margin-top: 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .dch-prices > div { background: var(--bg-000); padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .dch-prices .dch-rec { box-shadow: inset 0 2px 0 var(--accent); }
  .dch-price { font: 600 32px/1 var(--font-mono); }
  .dch-price span { font-size: 14px; color: var(--ink-muted); }
  .dch .faq { margin-top: 0; }
  .dch-res { display: flex; flex-direction: column; gap: 16px; }
  .dch-res a { display: flex; flex-direction: column; gap: 6px; padding: 16px; border: 1px solid var(--line); background: var(--bg-000); text-decoration: none; color: var(--ink); font: 600 16px/22px 'Inter Variable', var(--font-sans); }
  .dch-res a:hover { border-color: var(--accent); }
  .dch-template { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
  .dch-template h2 { font-size: clamp(32px, 4.4vw, 56px); line-height: 1.05; letter-spacing: -0.03em; }
  .dch-template p { margin: 0; color: var(--ink-muted); line-height: 26px; max-width: 40em; }
</style>
