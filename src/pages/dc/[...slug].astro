---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/dc/Base.astro";
import Badge from "../../components/dc/Badge.astro";
import Faq from "../../components/dc/Faq.astro";
import Shot from "../../components/dc/Shot.astro";
import Clip from "../../components/dc/Clip.astro";
import TemplateCTA from "../../components/dc/TemplateCTA.astro";
import PricingStrip from "../../components/dc/PricingStrip.astro";
import ToolChips from "../../components/dc/ToolChips.astro";
import { mailto } from "../../config/dc/product";
import { faqLd, softwareLd } from "../../lib/dc/schema";
import { u } from "../../lib/dc/url";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => ({ params: { slug: page.id }, props: { page, all: pages } }));
}

const { page, all } = Astro.props;
const d = page.data;
const { Content } = await render(page);
const path = `${page.id}/`;

const sectionInfo = {
  product: { name: "Product", path: "product/" },
  integrations: { name: "Integrations", path: "integrations/" },
  resources: { name: "Resources", path: "resources/" },
  company: null,
}[d.section];
const crumbs = [
  ...(sectionInfo && page.id !== "product" ? [sectionInfo] : []),
  { name: d.h1.replace(/[:·].*$/, "").trim(), path },
];
const siblings = all
  .filter((p) => p.data.section === d.section && p.id !== page.id && d.section !== "company")
  .sort((a, b) => a.data.order - b.data.order);
const isTool = d.section === "integrations";
const tool = page.id.replace(/^integrations\//, "");
const toolName = d.navLabel ?? d.h1;
// Connect panels show the numbers the dev log recorded against the demo instances (share/updatedc.md 13:58 / 15:05).
const connect: Record<string, { url: string; result: string }> = {
  zabbix: { url: "https://[your-zabbix]/api_jsonrpc.php", result: "6.0.48 · 1,417 hosts · 1,375 items · 130 problems" },
  netbox: { url: "https://[your-netbox]/api/", result: "4.7.3 · 24 sites · 42 racks · 72 devices · 108 cables" },
};
const panel = connect[tool];
const badgeLabel = { available: "Available", partial: "Partial", roadmap: "Roadmap", early: "Early access", partner: "Partner" };
const jsonLd = [
  ...(d.section === "product" || d.section === "integrations" ? [softwareLd()] : []),
  ...faqLd(d.faq),
];
---
<Base title={d.title} description={d.description} path={path} crumbs={crumbs} jsonLd={jsonLd}>
  {isTool && (
    <section class="int-hero">
      <div class="container int-grid">
        <div class="int-copy">
          <div class="int-status">
            {d.badge === "available" ? <span class="cs-chip cs-chip--ok"><span class="cs-shape cs-shape--ok" aria-hidden="true"></span>Available</span>
              : d.badge === "roadmap" ? <span class="cs-badge cs-badge--roadmap">Roadmap</span>
              : d.badge && <span class={`badge badge-${d.badge}`}>{badgeLabel[d.badge]}</span>}
            {d.badgeNote && <span class="int-note">{d.badgeNote}</span>}
          </div>
          <h1>{d.h1}</h1>
          <p class="int-lede">{d.directAnswer}</p>
          <div class="btn-row">
            <a class="cs-btn cs-btn--primary int-cta" href={mailto(`DC Sim and ${toolName}`, `Hi Da,\n\nI'd like a walkthrough of DC Sim with ${toolName}.\n\nCompany: \n`)}>Request a walkthrough</a>
            <a class="cs-btn cs-btn--secondary int-cta" href={u("resources/excel-template/")}>The template sheets</a>
          </div>
        </div>
        {panel ? (
          <div class="int-panel" aria-label={`Connect ${toolName}, as shown in the app`}>
            <div class="int-panel-head"><span class="cs-shape cs-shape--live" aria-hidden="true"></span>⋯ → Connect {toolName}</div>
            <div class="int-panel-body">
              <div class="cs-field"><span class="cs-field__head"><span>URL</span><span class="cs-field__unit">https</span></span><span class="cs-input int-fake">{panel.url}</span></div>
              <div class="cs-field"><span class="cs-field__head"><span>Read-only API token</span><span class="cs-field__unit">never shown in the browser</span></span><span class="cs-input int-fake">••••••••••••••••••••</span></div>
              <div class="int-test"><span class="cs-btn cs-btn--primary cs-btn--sm" aria-hidden="true">Test</span><span><span class="cs-shape cs-shape--ok" aria-hidden="true"></span> {panel.result}</span></div>
              <span class="int-demo">demo instance · tested</span>
            </div>
          </div>
        ) : (
          <div class="int-panel">
            <div class="int-panel-head"><span class="cs-shape cs-shape--off" aria-hidden="true"></span>Today</div>
            <ol class="int-today">
              <li>Export from {toolName}</li>
              <li>Map the columns onto the template sheets (synonyms accepted)</li>
              <li>Import: the same report and checks as any Excel upload</li>
            </ol>
          </div>
        )}
      </div>
    </section>
  )}
  {isTool && panel && (
    <section class="container int-steps">
      <span class="eyebrow">How the connector works</span>
      <h2>Connect, preview, import.</h2>
      <ol>
        <li class="on"><span>01</span><h3>Connect</h3><p>Open ⋯ → Connect, paste the URL and a read-only API token, press Test. The test shows the version and what it can see.</p></li>
        <li><span>02</span><h3>Preview</h3><p>The result is rendered as the template sheets with the same import report and checks as an Excel upload.</p></li>
        <li><span>03</span><h3>Import</h3><p>Confirm, and the twin is built or updated. Re-sync shows exactly what changed.</p></li>
      </ol>
    </section>
  )}
  <article class="container page">
    {!isTool && (<>
    <header class="page-head">
      {d.badge && <Badge kind={d.badge} note={d.badgeNote} />}
      <h1>{d.h1}</h1>
      <p class="direct-answer">{d.directAnswer}</p>
    </header>
    </>)}
    {d.ctaTop && <TemplateCTA />}
    {d.shots.length > 0 && (
      <div class={`grid ${d.shots.length > 1 ? "grid-2" : ""} shots`}>
        {d.shots.map((s, i) => <Shot name={s.name} alt={s.alt} caption={s.caption} light={s.light} eager={i === 0} />)}
      </div>
    )}
    <div class="prose"><Content /></div>
    {d.clips.length > 0 && (
      <section class="section" aria-label="Clips">
        <div class={`grid ${d.clips.length > 1 ? "grid-2" : ""}`}>
          {d.clips.map((c) => <Clip name={c.name} title={c.title} caption={c.caption} />)}
        </div>
      </section>
    )}
    <Faq items={d.faq} />
    {d.section === "product" && <PricingStrip />}
    {!d.ctaTop && <TemplateCTA compact={d.section === "company"} />}
    {isTool && (
      <section class="section int-others" aria-label="Other integrations">
        <span class="eyebrow">Other integrations</span>
        <ToolChips exclude={tool} />
      </section>
    )}
    {!isTool && siblings.length > 0 && (
      <nav class="section" aria-label="More in this section" style="margin-top:40px">
        <h2 style="margin-top:0">More in {sectionInfo?.name ?? "this section"}</h2>
        <div class="grid grid-3 tiles">
          {siblings.map((s) => (
            <a class="card" href={u(`${s.id}/`)}>
              <h3>{s.data.navLabel ?? s.data.h1}</h3>
              {s.data.badge && <Badge kind={s.data.badge} />}
            </a>
          ))}
        </div>
      </nav>
    )}
  </article>
</Base>
<style>
  .int-hero { border-bottom: 1px solid var(--line); background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px; }
  .int-grid { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(40px, 6vw, 72px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 40px; align-items: center; }
  .int-copy { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .int-copy h1 { margin: 0; font-size: clamp(34px, 4.4vw, 56px); }
  .int-status { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .int-note { font: 500 12px/16px var(--font-mono); color: var(--ink-muted); }
  .int-lede { margin: 0; color: var(--ink-muted); font-size: 17px; line-height: 27px; max-width: 34em; }
  .int-cta { height: 44px; padding: 0 20px; }
  .int-panel { border: 1px solid var(--line-strong); background: var(--bg-100); font: 400 13px/20px var(--font-mono); }
  .int-panel-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--line); color: var(--ink-muted); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
  .int-panel-body { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .int-fake { display: flex; align-items: center; color: var(--ink-muted); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .int-test { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; color: var(--ink); }
  .int-demo { color: var(--ink-dim); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .int-today { margin: 0; padding: 16px 16px 16px 36px; display: flex; flex-direction: column; gap: 10px; color: var(--ink); }
  .int-steps { padding-top: 64px; }
  .int-steps h2 { margin: 12px 0 28px; }
  .int-steps ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px; }
  .int-steps li { border-top: 2px solid var(--line-strong); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .int-steps li.on { border-top-color: var(--accent); }
  .int-steps li > span { font: 600 13px/1 var(--font-mono); color: var(--ink-muted); }
  .int-steps li.on > span { color: var(--accent); }
  .int-steps h3 { margin: 0; font-size: 18px; }
  .int-steps p { margin: 0; color: var(--ink-muted); line-height: 24px; font-size: 16px; }
  .int-others { display: flex; flex-direction: column; gap: 16px; margin-top: 40px; }
</style>
