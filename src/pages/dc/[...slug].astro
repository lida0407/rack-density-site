---
import { getCollection } from "astro:content";
import ContentPage from "../../views/dc/ContentPage.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => {
    const siblings = pages
      .filter((p) => p.data.section === page.data.section && p.id !== page.id && page.data.section !== "company")
      .sort((a, b) => a.data.order - b.data.order)
      .map((p) => ({ slug: p.id, label: p.data.navLabel ?? p.data.h1, badge: p.data.badge }));
    return { params: { slug: page.id }, props: { page, siblings } };
  });
}
const { page, siblings } = Astro.props;
---
<ContentPage page={page} slug={page.id} siblings={siblings} locale="en" />
