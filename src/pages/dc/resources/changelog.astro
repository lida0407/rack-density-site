---
import Base from "../../../layouts/dc/Base.astro";
import Badge from "../../../components/dc/Badge.astro";
import { u } from "../../../lib/dc/url";
// Entries live in src/data/dc/changelog.ts (also feeds /dc/rss.xml and the site-wide /rss.xml). Newest first.
import { CHANGELOG, IN_PROGRESS } from "../../../data/dc/changelog";
---
<Base
  title="Changelog — DC Sim"
  description="What shipped in DC Sim and what is in progress: airflow and heat, device fronts, LEDs, liquid loops, the Estate globe, Zabbix and NetBox, Excel import."
  path="resources/changelog/"
  crumbs={[{ name: "Resources", path: "resources/" }, { name: "Changelog", path: "resources/changelog/" }]}
>
  <article class="container page">
    <header class="page-head">
      <h1>Changelog</h1>
      <p class="direct-answer">What shipped, newest first, in plain words. Items that are not shipped yet are listed under In progress with a Roadmap badge; nothing on this site is described as available before it is.</p>
      <p class="muted small"><a href={u("rss.xml")}>RSS feed</a> of this changelog and new guides.</p>
    </header>
    <div class="prose">
      {CHANGELOG.map((e) => (
        <section id={e.id}>
          <h2>{e.title}</h2>
          <p class="muted small"><time datetime={e.date}>{e.date}</time></p>
          <ul>{e.items.map((i) => <li>{i}</li>)}</ul>
        </section>
      ))}
      <h2>In progress</h2>
      <ul>{IN_PROGRESS.map((i) => <li>{i} <Badge kind="roadmap" /></li>)}</ul>
    </div>
  </article>
</Base>
