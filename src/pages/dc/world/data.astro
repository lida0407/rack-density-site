---
// /dc/world/data/ — the open dataset page (WORLD-PAGE.md §1): licence, downloads, schema summary, corrections.
import Base from "../../../layouts/dc/Base.astro";
import { SITES, ESTATES, WORLD_META } from "../../../lib/dc/world";
import { u, abs, root } from "../../../lib/dc/url";
const dl = (p: string) => new URL(root(p), "https://rack-density.com").href;
const ld = { "@type": "Dataset", "@id": `${abs("world/data/")}#dataset`, name: "Famous data centers of the world", description: `${SITES.length} famous data center sites and ${ESTATES.length} estates (cable systems, cloud backbones, national compute networks, exchanges, financial routes) with coordinates, operator, opening year, power, PUE, cooling, a short story and sources.`,
  url: abs("world/data/"), license: "https://creativecommons.org/licenses/by/4.0/", isAccessibleForFree: true, creator: { "@id": abs("#org") }, dateModified: WORLD_META.synced,
  spatialCoverage: "Worldwide", keywords: ["data centers", "hyperscale", "submarine cables", "PUE", "AI data centers"],
  distribution: [
    { "@type": "DataDownload", encodingFormat: "application/geo+json", contentUrl: dl("dc/world/data/dc-world.geojson") },
    { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: dl("dc/world/data/dc-world.csv") },
  ] };
---
<Base title="Open dataset: famous data centers of the world (CC BY)" description={`${SITES.length} famous data centers and ${ESTATES.length} estates as GeoJSON, CSV and DC Sim workbooks, with sources for every record. Free under CC BY 4.0.`}
  path="world/data/" crumbs={[{ name: "World", path: "world/" }, { name: "Open dataset", path: "world/data/" }]} jsonLd={[ld]}>
  <article class="container page prose">
    <span class="eyebrow">World · open data</span>
    <h1>Famous data centers of the world: the open dataset</h1>
    <p class="direct-answer">{SITES.length} famous data center sites and {ESTATES.length} estates, each record with coordinates, operator, opening year, power, PUE, cooling, a short story, notable facts and at least two public sources. Free to use under <a href="https://creativecommons.org/licenses/by/4.0/" rel="noopener">CC BY 4.0</a> with a link to this page.</p>
    <h2>Downloads</h2>
    <ul>
      <li><a href={root("dc/world/data/dc-world.geojson")} download>dc-world.geojson</a>: every site as a GeoJSON point with its properties</li>
      <li><a href={root("dc/world/data/dc-world.csv")} download>dc-world.csv</a>: the same sites as a flat table</li>
      <li>Estate workbooks (DC Sim template v1.4, Sites and Links sheets): {ESTATES.map((e, i) => <>{i ? ", " : ""}<a href={root(`dc/world/data/estates/${e.id}.xlsx`)} download>{e.id}</a></>)}</li>
    </ul>
    <h2>What a site record holds</h2>
    <p><code>id, name, operator, owner, tenant_type</code> (hyperscale, colocation, AI, HPC, research, enterprise), <code>city, country, region, lat, lon</code> with the coordinate source, <code>year_opened, status, expansions, site_area_m2, building_area_m2, it_mw, total_mw, pue</code> (value and whether reported or estimated), <code>cooling, power, certifications, famous_for, notable, story, image</code> (only CC-licensed, with author and licence), <code>sources</code> (URL, title, publisher, date), <code>confidence</code> and the list of fields that are <code>estimated</code>.</p>
    <h2>What an estate record holds</h2>
    <p>The estate's name, operator, kind and year, its <strong>sites</strong> (code, place, coordinates, role, provider) and <strong>links</strong> (type, capacity, length, year, protected or not, carrier, sources), plus a story and notable facts.</p>
    <h2>How it is made</h2>
    <p>Every record is compiled from public sources (operators' own pages, filings, press, Wikidata, OpenStreetMap for coordinates) and checked before publication. Values the sources do not state directly are marked estimated. Latencies and what-ifs shown on the earth are our estimates from public numbers, not the operators' routing. Base map: Natural Earth (public domain); city list for "where's my data center": GeoNames (CC BY 4.0).</p>
    <h2>Corrections</h2>
    <p>Found a wrong number or a better source? Write to <a href="mailto:da@mustardseedmt.com?subject=dc-world%20correction">da@mustardseedmt.com</a> with the record id and the source; corrections are dated in the record's <code>updated</code> field. Last sync: {WORLD_META.synced}.</p>
    <p><a href={u("world/")}>Back to the earth</a> · <a href={u("world/estates/")}>All estates</a></p>
  </article>
</Base>
