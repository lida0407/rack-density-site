---
// The rack-density.com hub: both product lines and a teaser for the free calculator (/calculator/, CALCULATOR-PAGE.md).
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { DENSITY_PRESETS } from '../lib/calc/presets';
import { BRAND, PRODUCT_NAME, DC_PRODUCT_NAME, TRY } from '../config/brand';
---
<Base title={`3D Rack Twins for Homelab & Data Center | ${BRAND}`}
  description={`3D twins of your racks from the spreadsheet you already keep: ${PRODUCT_NAME} for the homelab, ${DC_PRODUCT_NAME} for the data center. Plus a free rack density calculator.`}
  path="/" ogImage="/og/hub.png" section="hub">
  <section class="hub-hero">
    <div class="wrap">
      <p class="status"><span class="dot" aria-hidden="true"></span>Free · runs in your browser · no data leaves it</p>
      <h1>See your racks: what they draw, what's plugged where, what fails.</h1>
      <p class="lead">Free tools and 3D twins built from the spreadsheet you already keep. One for the rack in your basement, one for the data hall.</p>
      <div class="grid grid-2 products">
        <a class="card product product--homelab" href={u('/homelab')}>
          <p class="eyebrow">For the homelab</p>
          <h2>{PRODUCT_NAME}</h2>
          <p>Your homelab rack, in 3D. Watts and cost per device, what's plugged where, and what goes dark when one thing fails. Try it free when we open the doors: no account, nothing stored.</p>
          <span class="go">Explore {PRODUCT_NAME} →</span>
          {!TRY.live && <span class="cs-badge cs-badge--roadmap">See it · walkthrough</span>}
        </a>
        <a class="card product product--dc" href={u('/dc')}>
          <p class="eyebrow">For the data center</p>
          <h2>{DC_PRODUCT_NAME}</h2>
          <p>Turn one Excel file into a 3D twin of your data center. Fail any UPS, feed, switch or cooler and see what goes dark. Built to sit on top of the monitoring you run.</p>
          <span class="go">Explore {DC_PRODUCT_NAME} →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight teaser" id="calculator">
    <div class="wrap">
      <div class="card teaser-card">
        <div>
          <p class="eyebrow">Free tool · Rack Density Calculator</p>
          <h2>How many devices fit before space, power or cooling runs out?</h2>
          <p class="muted">Pick a rack, set the watts and the circuit, and watch the rack fill up: devices per rack, kW, cost per month and the bottleneck.</p>
          <div class="chips">
            {DENSITY_PRESETS.map((p) => <a class="cs-chip" href={`${u('/calculator')}?preset=${p.id}`}>{p.label}</a>)}
          </div>
        </div>
        <a class="btn btn-primary" href={u('/calculator')}>Open the calculator →</a>
      </div>
    </div>
  </section>
</Base>
<style>
  .hub-hero { padding: 48px 0 28px; background: radial-gradient(700px 360px at 20% 0%, rgba(229,112,0,.10), transparent 70%), radial-gradient(700px 360px at 85% 10%, rgba(34,197,94,.08), transparent 70%); }
  .hub-hero h1 { max-width: 18em; }
  .status { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); padding: 6px 10px; border-radius: var(--radius-1); margin-bottom: 22px; }
  .status .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 8px var(--ok); }
  .products { margin-top: 28px; }
  /* Edition accent per card. Only the accent tokens switch (values from tokens.css, both themes); the card keeps the page's
     neutrals, so it follows the bright theme too (data-edition on a card would pull in the dark neutrals). */
  .product--dc { --accent: #22c55e; --accent-strong: #4ade80; --accent-soft: rgba(34,197,94,0.14); --glow-accent: 0 0 0 1px rgba(57,255,20,0.45), 0 0 24px rgba(57,255,20,0.28); }
  :global([data-theme='light']) .product--dc { --accent: #137a34; --accent-strong: #0f6a2c; --accent-soft: rgba(34,197,94,0.12); --glow-accent: 0 0 0 1px rgba(34,197,94,0.45), 0 0 18px rgba(34,197,94,0.22); }
  .product { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 6px; transition: border-color .15s, box-shadow .15s; border-top: 3px solid var(--accent); }
  .product h2 { margin: 0; }
  .product p { color: var(--ink-muted); margin: 0; }
  .product .eyebrow { margin: 0; }
  .product .go { color: var(--accent); font-weight: 650; margin-top: 8px; }
  .product .cs-badge { align-self: flex-start; }
  .product:hover { border-color: var(--accent); color: var(--ink); box-shadow: var(--glow-accent); }
  .teaser-card { display: grid; gap: 18px; align-items: center; border-top: 3px solid var(--accent); }
  @media (min-width: 860px) { .teaser-card { grid-template-columns: 1fr auto; } }
  .teaser-card h2 { margin: 0 0 6px; font-size: clamp(1.3rem, 2.6vw, 1.7rem); }
  .teaser-card p { margin: 0 0 14px; }
  .teaser-card .chips { gap: 8px; }
  .teaser-card .cs-chip { text-decoration: none; min-height: 36px; }
</style>
