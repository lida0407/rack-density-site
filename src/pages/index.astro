---
// The rack-density.com hub: both product lines and the free calculator (the domain's original page).
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import RackDensity from '../components/calc/RackDensity.astro';
import { u, abs } from '../lib/url';
import { BRAND, PRODUCT_NAME, DC_PRODUCT_NAME, TRY } from '../config/brand';
import { calculatorFaq } from '../data/faq';
const calc = { '@context': 'https://schema.org', '@type': 'WebApplication', name: 'Rack Density Calculator', url: abs('/') + '#calculator',
  description: 'Calculate how many servers or homelab devices fit in one rack by space, power and cooling, the kW per rack, and the monthly electricity cost. Presets for 10-inch mini racks, 12U wall racks, 22U and 42U racks.',
  applicationCategory: 'UtilitiesApplication', operatingSystem: 'Any', isAccessibleForFree: true, offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' } };
---
<Base title={`Rack Density Calculator & 3D Rack Twins | ${BRAND}`}
  description="Free rack density calculator: devices per rack by space, power and cooling, kW per rack and cost per month. Plus 3D twins for your homelab and your data center."
  path="/" ogImage="/og/hub.png" schema={[calc]} section="hub">
  <section class="hub-hero">
    <div class="wrap">
      <p class="status"><span class="dot" aria-hidden="true"></span>Free · runs in your browser · no data leaves it</p>
      <h1>See your racks: what they draw, what's plugged where, what fails.</h1>
      <p class="lead">Free tools and 3D twins built from the spreadsheet you already keep. One for the rack in your basement, one for the data hall.</p>
      <div class="grid grid-2 products">
        <a class="card product theme-homelab" data-edition="homelab" href={u('/homelab')}>
          <p class="eyebrow">For the homelab</p>
          <h2>{PRODUCT_NAME}</h2>
          <p>Your homelab rack, in 3D. Watts and cost per device, what's plugged where, and what goes dark when one thing fails. Free, no account, nothing stored.</p>
          <span class="go">Explore {PRODUCT_NAME} →</span>
          {!TRY.live && <span class="pill pill-soon">Try: {TRY.comingNote}</span>}
        </a>
        <a class="card product theme-dc" data-edition="dc" href={u('/dc')}>
          <p class="eyebrow">For the data center</p>
          <h2>{DC_PRODUCT_NAME}</h2>
          <p>Turn one Excel file into a 3D twin of your data center. Fail any UPS, feed, switch or cooler and see what goes dark. Built to sit on top of the monitoring you run.</p>
          <span class="go">Explore {DC_PRODUCT_NAME} →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-tight" id="calculator">
    <div class="wrap">
      <p class="eyebrow">Free tool · runs in your browser, no data leaves it</p>
      <h2 class="calc-h">Rack Density Calculator</h2>
      <p class="lead">How many devices fit in your rack before space, power or cooling runs out, and which one runs out first? Works for a 10-inch mini rack in a closet or a 42U rack in a data hall.</p>
      <RackDensity />
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap narrow prose">
      <h2>How rack density is calculated</h2>
      <pre><code>by_space   = floor(rack_U / device_U)
by_power   = floor(circuit_kW × 1000 / W_per_device)
by_cooling = floor(cooling_kW × 1000 / W_per_device)
devices    = min(by_space, by_power, by_cooling)
circuit_kW = V × A × PF / 1000          (single-phase)
circuit_kW = √3 × V × A × PF / 1000     (three-phase)</code></pre>
      <p>Real rack density is the floor of three independent ceilings. Whichever is lowest is the bottleneck: usually power or heat in a homelab, cooling in a modern data center, space only in very small racks.</p>
      <h2>More calculators</h2>
      <ul>
        <li><a href={u('/homelab/learn/homelab-power-calculator')}>Homelab power cost</a>: what your whole lab costs per month, device by device</li>
        <li><a href={u('/homelab/learn/tokens-per-watt')}>Tokens per watt</a>: the efficiency of your home AI box</li>
        <li><a href={u('/homelab/learn/10-inch-mini-rack-planner')}>10-inch rack planner</a>: will it fit, and how many U</li>
        <li><a href={u('/homelab/learn/proxmox-power-usage')}>Idle savings and payback</a></li>
        <li><a href={u('/dc/resources/calculators/rack-power')}>Rack power calculator</a>: load per PDU in normal and failover against the 80 % rule</li>
      </ul>
    </div>
  </section>
  <section class="section"><div class="wrap narrow"><Faq items={calculatorFaq} /></div></section>
</Base>
<style>
  .hub-hero { padding: 48px 0 28px; background: radial-gradient(700px 360px at 20% 0%, rgba(229,112,0,.10), transparent 70%), radial-gradient(700px 360px at 85% 10%, rgba(34,197,94,.08), transparent 70%); }
  .hub-hero h1 { max-width: 18em; }
  .status { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); padding: 6px 10px; border-radius: var(--radius-1); margin-bottom: 22px; }
  .status .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); box-shadow: 0 0 8px var(--ok); }
  .products { margin-top: 28px; }
  .product { text-decoration: none; color: var(--text); display: flex; flex-direction: column; gap: 6px; transition: border-color .15s, box-shadow .15s; border-top: 3px solid var(--accent); }
  .product h2 { margin: 0; }
  .product p { color: var(--ink-muted); margin: 0; }
  .product .eyebrow { margin: 0; }
  .product .go { color: var(--accent); font-weight: 650; margin-top: 8px; }
  .product .pill { align-self: flex-start; }
  .product:hover { border-color: var(--accent); color: var(--text); box-shadow: var(--glow-accent); }
  .calc-h { font-size: clamp(1.8rem, 4vw, 2.6rem); }
</style>
