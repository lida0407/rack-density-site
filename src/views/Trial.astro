---
// /try/, /de/try/, /zh/try/: sign-up for the one-session trial (~/Sensaka/TRY-SIGNUP.md §1, §3, §6). Copy in
// src/i18n/pages/trial.ts. The form posts natively to /api/try/signup (303 to the app with the rd_pass cookie); with
// JavaScript it posts JSON, then follows the returned link, shows the trial-used screen, or (preview, TRIAL_DRY) the pass.
// Built only in preview builds until TRIAL_LIVE (src/config/trial.mjs); noindex until then.
import Base from '../layouts/Base.astro';
import { u } from '../lib/url';
import { PRODUCT_NAME, DC_PRODUCT_NAME, WAITLIST, CONTACT_EMAIL, MAILTO } from '../config/brand';
import { TEMPLATE_FILE } from '../config/dc/product';
import { TRIAL_LIVE } from '../config/trial.mjs';
import { lp, fill, pageCopy, type Locale } from '../i18n';
import * as copy from '../i18n/pages/trial';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { c, fellBack } = pageCopy(copy, locale);
const js = { ...c.js, lang: locale };
const files = {
  homelab: [[u('/downloads/homelab-template.xlsx'), c.prep.homelab.template], [u('/downloads/basement-lab.xlsx'), c.prep.homelab.sample]],
  dc: [[u(`/dc/${TEMPLATE_FILE}`), c.prep.dc.template], [u('/dc/downloads/demo-hall.xlsx'), c.prep.dc.sample]],
};
---
<Base title={c.title} description={c.description} path="/try" ogImage="/homelab/og/try.png" section="hub" crumbs={[{ name: c.crumb }]} locale={locale} fallback={fellBack} noindex={!TRIAL_LIVE}>
  <section class="section-tight">
    <div class="wrap narrow tr">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <ul class="lines">{c.lines.map((l) => <li>{l}</li>)}</ul>

      <form class="card form" method="post" action="/api/try/signup" data-trial data-t={JSON.stringify(js)}>
        <fieldset class="field ed"><legend>{c.form.product}</legend>
          <label class="opt"><input type="radio" name="edition" value="homelab" checked /> <span><b>{PRODUCT_NAME}</b><small>{c.form.homelab}</small></span></label>
          <label class="opt"><input type="radio" name="edition" value="dc" /> <span><b>{DC_PRODUCT_NAME}</b><small>{c.form.dc}</small></span></label>
        </fieldset>
        <label class="field">{c.form.email} <input type="email" name="email" required maxlength="254" autocomplete="email" inputmode="email" /></label>
        <label class="field">{c.form.note} <span class="hint">{c.form.optional}</span>
          <input type="text" name="note" maxlength="120" placeholder={c.form.placeholder} /></label>
        <label class="check"><input type="checkbox" name="updates" value="1" /> <span>{c.form.updates}<small>{c.form.updatesHint}</small></span></label>
        <input type="hidden" name="lang" value={locale} />
        <input type="hidden" name="src" value="try" />
        <div class="cf-turnstile" data-sitekey={WAITLIST.siteKey} data-theme="dark" data-size="flexible"></div>
        <button class="btn btn-primary" type="submit">{c.form.submit}</button>
        <p class="small muted" data-msg aria-live="polite"></p>
        <pre class="dry" data-dry hidden></pre>
        <p class="small muted" set:html={fill(c.form.fine, { privacy: `<a href="${lp('/privacy', locale)}">${c.form.privacy}</a>` })}></p>
      </form>

      <div class="card used" data-used hidden>
        <h2>{c.used.h2}</h2>
        <p set:html={fill(c.used.p, { mail: `<a href="${MAILTO}">${CONTACT_EMAIL}</a>` })}></p>
        <a class="btn btn-ghost" href={`${lp('/homelab/waitlist', locale)}?src=try-used`}>{c.used.waitlist}</a>
      </div>

      <h2 class="prep-h">{c.prep.h2}</h2>
      <p class="muted">{c.prep.p}</p>
      <div class="grid grid-2 prep">
        <div class="card" data-prep="homelab"><p class="k">{PRODUCT_NAME}</p>
          <ul>{files.homelab.map(([href, t]) => <li><a href={href} download>{t}</a></li>)}<li><a href={lp('/homelab/try', locale)}>{c.prep.homelab.seeIt}</a></li></ul></div>
        <div class="card" data-prep="dc"><p class="k">{DC_PRODUCT_NAME}</p>
          <ul>{files.dc.map(([href, t]) => <li><a href={href} download>{t}</a></li>)}</ul></div>
      </div>
    </div>
  </section>
  <script is:inline>
    document.querySelectorAll('.cf-turnstile').forEach(function (e) { e.dataset.theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark'; });
  </script>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
</Base>
<style>
  .tr h1 { margin-bottom: .3em; }
  .lines { padding-left: 1.1em; margin: 0 0 6px; display: grid; gap: 4px; color: var(--ink-muted); }
  .form { display: grid; gap: 14px; margin: 22px 0 12px; }
  .ed { border: 0; padding: 0; margin: 0; display: grid; gap: 8px; }
  .ed legend { padding: 0; margin-bottom: 6px; }
  .opt, .check { display: flex; align-items: flex-start; gap: 10px; text-transform: none; letter-spacing: 0; font: 400 1rem/1.4 var(--font-sans, inherit); color: var(--ink); cursor: pointer; }
  .opt { padding: 10px 12px; border: 1px solid var(--line-strong); border-radius: var(--radius-1); }
  .opt:has(input:checked) { border-color: var(--accent); background: var(--accent-soft); }
  .opt small, .check small { display: block; color: var(--ink-muted); font-size: .85rem; margin-top: 2px; }
  .opt input, .check input { width: 18px; height: 18px; min-height: 0; margin: 2px 0 0; padding: 0; flex: none; accent-color: var(--accent); }
  .form .btn { justify-self: start; }
  [data-msg]:empty { display: none; }
  [data-msg].err { color: var(--crit); }
  .dry { white-space: pre-wrap; word-break: break-all; font: 400 12px/1.5 var(--font-mono); background: var(--bg-000); border: 1px solid var(--line); padding: 10px; margin: 0; }
  .used { margin: 22px 0 12px; display: grid; gap: 10px; justify-items: start; }
  .used[hidden], .dry[hidden], .form[hidden] { display: none; }
  .used h2 { margin: 0; font-size: 1.3rem; }
  .used p { margin: 0; }
  .prep-h { margin-top: 32px; font-size: 1.3rem; }
  .prep { margin-top: 12px; }
  .prep .k { margin: 0 0 6px; font: 600 11px/14px var(--font-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-muted); }
  .prep ul { margin: 0; padding-left: 1.1em; display: grid; gap: 4px; }
  .prep .card.on { border-color: var(--accent); }
</style>
<script>
  const f = document.querySelector<HTMLFormElement>('[data-trial]');
  if (f) {
    const T: Record<string, string> = JSON.parse(f.dataset.t ?? '{}');
    const msg = f.querySelector<HTMLElement>('[data-msg]')!, dry = f.querySelector<HTMLElement>('[data-dry]')!;
    const used = document.querySelector<HTMLElement>('[data-used]')!;
    const q = new URLSearchParams(location.search);
    // Edition: ?edition= wins, else the section the visitor came from (a /dc/ referrer on this site).
    const want = q.get('edition') ?? (/^\/((de|zh)\/)?dc(\/|$)/.test(document.referrer ? new URL(document.referrer).pathname : '') ? 'dc' : 'homelab');
    const radio = f.querySelector<HTMLInputElement>(`[name="edition"][value="${want === 'dc' ? 'dc' : 'homelab'}"]`); if (radio) radio.checked = true;
    const mark = () => { const ed = (f.querySelector<HTMLInputElement>('[name="edition"]:checked')?.value) ?? 'homelab'; document.querySelectorAll<HTMLElement>('[data-prep]').forEach((c) => c.classList.toggle('on', c.dataset.prep === ed)); };
    f.addEventListener('change', mark); mark();
    const src = q.get('src'); if (src && /^[a-z0-9_-]{1,21}$/i.test(src)) (f.elements.namedItem('src') as HTMLInputElement).value = src.toLowerCase();
    f.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(f).entries()) as Record<string, string>;
      const btn = f.querySelector('button')!; btn.disabled = true; msg.className = ''; msg.textContent = T.sending; dry.hidden = true;
      try {
        const r = await fetch(f.action, { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ email: data.email, edition: data.edition, note: data.note, updates: data.updates === '1', lang: data.lang, src: data.src, turnstile: data['cf-turnstile-response'] }) });
        const j = await r.json();
        if (j.ok && j.dry) { msg.textContent = T.dry; dry.textContent = JSON.stringify(j, null, 2); dry.hidden = false; btn.disabled = false; (window as any).turnstile?.reset(); return; }
        if (j.ok) { location.href = j.to; return; }
        if (j.reason === 'used') { f.hidden = true; used.hidden = false; used.scrollIntoView({ block: 'center' }); return; }
        msg.className = 'err'; msg.textContent = T[j.reason] ?? T.down;
      } catch { msg.className = 'err'; msg.textContent = T.down; }
      btn.disabled = false; (window as any).turnstile?.reset();
    });
  }
</script>
