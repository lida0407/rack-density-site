---
// /dc/world/estates/ in one locale (I18N.md): the famous estates by kind. Copy in the "world" dictionary (estates.*); estate
// names and lines stay English, and the estate pages they link to are English-only (marked "(English)").
import Base from "../../../layouts/dc/Base.astro";
import { ESTATES, estatePath } from "../../../lib/dc/world";
import { worldCopy } from "../../../i18n/dc/world";
import type { Locale } from "../../../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const w = worldCopy(locale, "/dc/world/estates");
const { t } = w;
const N = { "ESTATES.length": ESTATES.length };
const kinds = [...new Set(ESTATES.map((e) => e.kind ?? "other"))];
---
<Base title={t("estates.meta.title")} description={t("estates.meta.description", N)}
  path="world/estates/" crumbs={[{ name: t("common.crumb.world"), path: "world/" }, { name: t("common.crumb.estates"), path: "world/estates/" }]} locale={locale}
  fallback={w.missing(["estates.", "labels.kind.", "common.sitesLinksCount"])}>
  <article class="container page">
    <span class="eyebrow">{t("estates.eyebrow")}</span>
    <h1 style="margin:10px 0 0">{t("estates.h1")}</h1>
    <p class="direct-answer" style="margin-top:24px">{t("estates.lede", N)}</p>
    {kinds.map((k) => (
      <section style="margin-top:32px"><h2 style="margin:0 0 12px;font-size:22px">{w.kindLabel(k)}</h2>
        <div class="grid grid-2">{ESTATES.filter((e) => (e.kind ?? "other") === k).map((e) => (
          <a class="cs-card" href={w.href(estatePath(e))} style="text-decoration:none;color:var(--ink);display:flex;flex-direction:column;gap:6px">
            <span style="font:600 18px/24px 'Inter Variable',var(--font-sans)">{e.name}{w.enOnly(estatePath(e))}</span>
            <span style="color:var(--ink-muted);font-size:15px;line-height:22px">{e.famous_for}</span>
            <span style="font:500 11px/14px var(--font-mono);color:var(--ink-dim)">{t("common.sitesLinksCount", { "e.sites.length": e.sites.length, "e.links.length": e.links.length })}{e.year ? ` · ${e.year}` : ""}</span>
          </a>))}</div>
      </section>
    ))}
  </article>
</Base>
