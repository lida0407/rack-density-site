---
// A DC content page (src/content/dc/pages, or its translation in src/content/dc/l10n/<locale>/) in one locale.
// English renders the Markdown component; translations render the stored HTML with links sent to the translated page when
// there is one, else to the English page marked "(English)" (marketing/I18N.md).
import { render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/dc/Base.astro";
import Badge from "../../components/dc/Badge.astro";
import Faq from "../../components/dc/Faq.astro";
import Shot from "../../components/dc/Shot.astro";
import Clip from "../../components/dc/Clip.astro";
import TemplateCTA from "../../components/dc/TemplateCTA.astro";
import PricingStrip from "../../components/dc/PricingStrip.astro";
import ToolChips from "../../components/dc/ToolChips.astro";
import DeviceData from "../../components/dc/DeviceData.astro";
import { mailto } from "../../config/dc/product";
import { faqLd, softwareLd, howToLd } from "../../lib/dc/schema";
import { root } from "../../lib/dc/url";
import { dcCopy, dcLp, localizeLinks } from "../../i18n/dc";
import { label, lp, type Locale } from "../../i18n";

type Page = CollectionEntry<"pages"> | CollectionEntry<"pagesL10n">;
interface Props {
  page: Page;          // the entry to show (English or translated)
  slug: string;        // English id, e.g. "integrations/zabbix"
  siblings: { slug: string; label: string; badge?: Page["data"]["badge"] }[]; // same section, already in this locale
  locale: Locale;
}
const { page, slug, siblings, locale } = Astro.props;
const d = page.data;
const { Content } = locale === "en" ? await render(page) : { Content: null };
const html = locale === "en" ? "" : localizeLinks(page.rendered?.html ?? "", `/dc/${slug}/`, locale);
const path = `${slug}/`;
const { t: tp } = dcCopy("page", locale);
const { t: tc } = dcCopy("components", locale);

const sectionInfo = {
  product: { name: label(locale, "Product"), path: "product/" },
  integrations: { name: label(locale, "Integrations"), path: "integrations/" },
  resources: { name: label(locale, "Resources"), path: "resources/" },
  company: null,
}[d.section];
const crumbs = [
  ...(sectionInfo && slug !== "product" ? [sectionInfo] : []),
  { name: d.h1.replace(/[:·：].*$/, "").trim(), path },
];
const isTool = d.section === "integrations";
const tool = slug.replace(/^integrations\//, "");
const toolName = d.navLabel ?? d.h1;
// Connect panels show the numbers the dev log recorded against the demo instances (share/updatedc.md 13:58 / 15:05).
const connect: Record<string, { url: string; result: string }> = {
  zabbix: { url: "https://[your-zabbix]/api_jsonrpc.php", result: "6.0.48 · 1,417 hosts · 1,375 items · 130 problems" },
  netbox: { url: "https://[your-netbox]/api/", result: "4.7.3 · 24 sites · 42 racks · 72 devices · 108 cables" },
};
const panel = connect[tool];
const badgeLabel = (b: string) => tc(`badge.${b}`);
// Planned connectors collect demand on the shared waitlist (edition preselected, ?src = the tool).
const wantHref = d.badge === "planned" ? `${lp("/homelab/waitlist", locale)}?src=${tool}&edition=dc` : null; // = /waitlist?src=… (the 301 target)
// Open device data per product page (Dali's SEO decision §2): which /devices/ categories each layer draws on.
const DEVICE_CATS: Record<string, string[]> = {
  "product/it": ["server", "gpu_server", "rack_system", "accelerator", "gpu", "cpu", "storage", "switch"],
  "product/facility": ["ups", "rack_pdu", "crah", "inrow", "cdu", "rear_door_hx", "genset", "fire_detection", "fire_suppression", "leak_detection", "rack"],
  "product/design": ["rack", "server", "gpu_server", "rack_system", "storage", "switch", "rack_pdu", "ups", "crah", "inrow", "cdu", "rear_door_hx"],
};
const deviceCats = DEVICE_CATS[slug] ?? [];
// Zabbix and NetBox connect directly: the three on-page steps as HowTo (SEO-GEO-PLAN §3).
const connectSteps = panel ? [
  { name: tp("steps.connect"), text: tp("steps.connect.ld", { tool: toolName }) },
  { name: tp("steps.preview"), text: tp("steps.preview.p") },
  { name: tp("steps.import"), text: tp("steps.import.p") },
] : [];
const jsonLd = [
  ...(d.section === "product" || d.section === "integrations" ? [softwareLd()] : []),
  ...howToLd(tp("howto.name", { tool: toolName }), tp("howto.description", { tool: toolName }), connectSteps, "PT10M"),
  ...faqLd(d.faq),
];
---
<Base title={d.title} description={d.description} path={path} crumbs={crumbs} jsonLd={jsonLd} locale={locale}>
  {isTool && (
    <section class="int-hero">
      <div class="container int-grid">
        <div class="int-copy">
          <div class="int-status">
            {d.badge === "available" ? <span class="cs-chip cs-chip--ok"><span class="cs-shape cs-shape--ok" aria-hidden="true"></span>{badgeLabel("available")}</span>
              : d.badge === "roadmap" || d.badge === "planned" ? <span class="cs-badge cs-badge--roadmap">{badgeLabel(d.badge)}</span>
              : d.badge && <span class={`badge badge-${d.badge}`}>{badgeLabel(d.badge)}</span>}
            {d.badgeNote && <span class="int-note">{d.badgeNote}</span>}
          </div>
          <h1>{d.h1}</h1>
          <p class="int-lede">{d.directAnswer}</p>
          <div class="btn-row">
            {wantHref && <a class="cs-btn cs-btn--primary int-cta" href={wantHref}>{tp("wantThis")}</a>}
            <a class:list={["cs-btn int-cta", wantHref ? "cs-btn--secondary" : "cs-btn--primary"]} href={mailto(`DC Sim and ${toolName}`, `Hi Da,\n\nI'd like a walkthrough of DC Sim with ${toolName}.\n\nCompany: \n`)}>{tc("templateCta.btnWalkthrough")}</a>
            {!wantHref && <a class="cs-btn cs-btn--secondary int-cta" href={dcLp("resources/excel-template/", locale)}>{tp("templateSheets")}</a>}
          </div>
        </div>
        {panel ? (
          <div class="int-panel" aria-label={tp("connectAria", { tool: toolName })}>
            <div class="int-panel-head"><span class="cs-shape cs-shape--live" aria-hidden="true"></span>⋯ → Connect {toolName}</div>
            <div class="int-panel-body">
              <div class="cs-field"><span class="cs-field__head"><span>URL</span><span class="cs-field__unit">https</span></span><span class="cs-input int-fake">{panel.url}</span></div>
              <div class="cs-field"><span class="cs-field__head"><span>Read-only API token</span><span class="cs-field__unit">{tp("tokenUnit")}</span></span><span class="cs-input int-fake">••••••••••••••••••••</span></div>
              <div class="int-test"><span class="cs-btn cs-btn--primary cs-btn--sm" aria-hidden="true">Test</span><span><span class="cs-shape cs-shape--ok" aria-hidden="true"></span> {panel.result}</span></div>
              <span class="int-demo">{tp("demoTested")}</span>
            </div>
          </div>
        ) : (
          <div class="int-panel">
            <div class="int-panel-head"><span class="cs-shape cs-shape--off" aria-hidden="true"></span>{tp("today")}</div>
            <ol class="int-today">
              <li>{tp("today.export", { tool: toolName })}</li>
              <li>{tp("today.map")}</li>
              <li>{tp("today.import")}</li>
            </ol>
          </div>
        )}
      </div>
    </section>
  )}
  {isTool && panel && (
    <section class="container int-steps">
      <span class="eyebrow">{tp("steps.eyebrow")}</span>
      <h2>{tp("steps.h2")}</h2>
      <ol>
        <li class="on"><span>01</span><h3>{tp("steps.connect")}</h3><p>{tp("steps.connect.p")}</p></li>
        <li><span>02</span><h3>{tp("steps.preview")}</h3><p>{tp("steps.preview.p")}</p></li>
        <li><span>03</span><h3>{tp("steps.import")}</h3><p>{tp("steps.import.p")}</p></li>
      </ol>
    </section>
  )}
  <article class="container page">
    {!isTool && (<>
    <header class="page-head">
      {d.badge && <Badge kind={d.badge} note={d.badgeNote} locale={locale} />}
      <h1>{d.h1}</h1>
      <p class="direct-answer">{d.directAnswer}</p>
    </header>
    </>)}
    {d.ctaTop && <TemplateCTA locale={locale} />}
    {d.shots.length > 0 && (
      <div class={`grid ${d.shots.length > 1 ? "grid-2" : ""} shots`}>
        {d.shots.map((s, i) => <Shot name={s.name} alt={s.alt} caption={s.caption} light={s.light} eager={i === 0} locale={locale} />)}
      </div>
    )}
    {Content ? <div class="prose"><Content /></div> : <div class="prose" set:html={html} />}
    {d.clips.length > 0 && (
      <section class="section" aria-label={tp("clipsAria")}>
        <div class={`grid ${d.clips.length > 1 ? "grid-2" : ""}`}>
          {d.clips.map((c) => <Clip name={c.name} title={c.title} caption={c.caption} locale={locale} />)}
        </div>
      </section>
    )}
    {deviceCats.length > 0 && <DeviceData cats={deviceCats} locale={locale} />}
    <Faq items={d.faq} locale={locale} />
    {d.section === "product" && <PricingStrip locale={locale} />}
    {!d.ctaTop && <TemplateCTA compact={d.section === "company"} locale={locale} />}
    {isTool && (
      <section class="section int-others" aria-label={tp("otherIntegrations")}>
        <span class="eyebrow">{tp("otherIntegrations")}</span>
        <ToolChips exclude={tool} locale={locale} />
      </section>
    )}
    {!isTool && siblings.length > 0 && (
      <nav class="section" aria-label={tp("moreInAria")} style="margin-top:40px">
        <h2 style="margin-top:0">{tp("moreIn", { section: sectionInfo?.name ?? tp("thisSection") })}</h2>
        <div class="grid grid-3 tiles">
          {siblings.map((s) => (
            <a class="card" href={dcLp(`${s.slug}/`, locale)}>
              <h3>{s.label}</h3>
              {s.badge && <Badge kind={s.badge} locale={locale} />}
            </a>
          ))}
        </div>
      </nav>
    )}
  </article>
</Base>
<style>
  .int-hero { border-bottom: 1px solid var(--line); background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px); background-size: 48px 48px; }
  .int-grid { padding-top: clamp(40px, 6vw, 72px); padding-bottom: clamp(40px, 6vw, 72px); display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 40px; align-items: center; }
  .int-copy { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .int-copy h1 { margin: 0; font-size: clamp(34px, 4.4vw, 56px); }
  .int-status { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .int-note { font: 500 12px/16px var(--font-mono); color: var(--ink-muted); }
  .int-lede { margin: 0; color: var(--ink-muted); font-size: 17px; line-height: 27px; max-width: 34em; }
  .int-cta { height: 44px; padding: 0 20px; }
  .int-panel { border: 1px solid var(--line-strong); background: var(--bg-100); font: 400 13px/20px var(--font-mono); }
  .int-panel-head { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--line); color: var(--ink-muted); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
  .int-panel-body { padding: 16px; display: flex; flex-direction: column; gap: 12px; }
  .int-fake { display: flex; align-items: center; color: var(--ink-muted); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
  .int-test { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; color: var(--ink); }
  .int-demo { color: var(--ink-dim); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; }
  .int-today { margin: 0; padding: 16px 16px 16px 36px; display: flex; flex-direction: column; gap: 10px; color: var(--ink); }
  .int-steps { padding-top: 64px; }
  .int-steps h2 { margin: 12px 0 28px; }
  .int-steps ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 24px; }
  .int-steps li { border-top: 2px solid var(--line-strong); padding-top: 16px; display: flex; flex-direction: column; gap: 8px; }
  .int-steps li.on { border-top-color: var(--accent); }
  .int-steps li > span { font: 600 13px/1 var(--font-mono); color: var(--ink-muted); }
  .int-steps li.on > span { color: var(--accent); }
  .int-steps h3 { margin: 0; font-size: 18px; }
  .int-steps p { margin: 0; color: var(--ink-muted); line-height: 24px; font-size: 16px; }
  .int-others { display: flex; flex-direction: column; gap: 16px; margin-top: 40px; }
</style>
