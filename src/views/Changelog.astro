---
// Changelog, shared by /homelab/changelog/, /de/…, /zh/…; shell copy in src/i18n/pages/changelog.ts, entries stay English.
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { u } from '../lib/url';
import { fill, pageCopy, type Locale } from '../i18n';
import * as copy from '../i18n/pages/changelog';
interface Props { locale: Locale }
const { locale } = Astro.props;
const { c, fellBack } = pageCopy(copy, locale);
const entries = (await getCollection('changelog')).sort((a, b) => +b.data.date - +a.data.date);
const rendered = await Promise.all(entries.map(async (e) => ({ e, C: (await render(e)).Content })));
---
<Base title={c.title} description={c.description} path="/homelab/changelog" ogImage="/homelab/og/home.png" section="homelab" crumbs={[{ name: c.crumb }]} locale={locale} fallback={fellBack}>
  <section class="section-tight">
    <div class="wrap narrow">
      <h1>{c.h1}</h1>
      <p class="lead" set:html={fill(c.lead, { rss: `<a href="${u('/homelab/rss.xml')}">RSS</a>` })}></p>
      {c.entriesNote && <p class="small muted">{c.entriesNote}</p>}
      {rendered.map(({ e, C }) => (
        <article class="entry prose" id={e.id} lang={locale === 'en' ? undefined : 'en'}>
          <p class="small muted"><time datetime={e.data.date.toISOString().slice(0, 10)}>{e.data.date.toLocaleDateString(c.dateLocale, { day: 'numeric', month: 'long', year: 'numeric' })}</time></p>
          <h2>{e.data.title}</h2>
          <C />
        </article>
      ))}
    </div>
  </section>
</Base>
<style>.entry { border-top: 1px solid var(--line); padding-top: 24px; margin-top: 24px; } .entry h2 { margin-top: .2em; }</style>
