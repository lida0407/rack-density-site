---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/site/ThemeScript.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import { trail, crumbsSchema, type Crumb } from '../lib/crumbs';
import { ENTITY } from '../config/entity';
import { abs, u } from '../lib/url';
import { BRAND, PRODUCT_NAME, SITE_URL, BASE, COMPANY, CONTACT_EMAIL, CF_WEB_ANALYTICS_TOKEN } from '../config/brand';
import { ui, alternates, localeOf, lp, isLive, LOCALE_META, LOCALES, hasPage, type Locale } from '../i18n';

interface Props {
  title: string;               // full <title>
  description: string;
  path: string;                // route path like '/pricing'
  ogImage?: string;            // path under public, e.g. '/homelab/og/home.png'
  schema?: object[];           // JSON-LD objects for this page
  noindex?: boolean;
  section?: 'hub' | 'homelab';  // drives the header and the theme class (theme-hub / theme-homelab); DC pages use layouts/dc/Base.astro
  crumbs?: Crumb[];             // page crumbs after RACKDENSITY › section (last = this page); omit on section homes
  locale?: Locale;              // default: from the URL (/de/…, /zh/…); `path` is always the English path
  fallback?: boolean;           // some copy fell back to English → small note under the breadcrumbs
}
const { title, description, path, ogImage = '/og/hub.png', schema = [], noindex = false, section = 'hub', crumbs, fallback = false } = Astro.props;
const locale: Locale = Astro.props.locale ?? localeOf(Astro.url.pathname);
const t = ui(locale);
const bc = crumbs ? trail(section, crumbs) : null;
const ld = bc ? [...schema, crumbsSchema(bc, path, locale)] : schema;
const canonical = locale === 'en' ? abs(path) : `${SITE_URL}${lp(path, locale)}`;
// A locale that is not launched yet (src/i18n/live.mjs) is readable but noindex and outside hreflang.
const alts = isLive(locale) ? alternates(path) : [];
const org = {
  '@context': 'https://schema.org',
  '@graph': [
    // Entity rule: the Organization is the company (Mustard Seed Solutions); RACKDENSITY is its brand (no Sensaka on this site).
    { '@type': 'Organization', '@id': `${abs('/')}#org`, name: COMPANY.name, url: COMPANY.url, email: CONTACT_EMAIL,
      address: { '@type': 'PostalAddress', addressCountry: COMPANY.country }, description: ENTITY.company,
      brand: [{ '@type': 'Brand', name: BRAND, url: abs('/'), logo: `${SITE_URL}${u('/icon-512.png')}` }] },
    { '@type': 'WebSite', '@id': `${abs('/')}#website`, name: BRAND, url: abs('/'), description: ENTITY.rackdensity, publisher: { '@id': `${abs('/')}#org` } }, // marketing/ENTITY.md, verbatim
  ],
};
const ogTitle = title.replace(/ \| .*$/, '');
---
<!doctype html>
<html lang={LOCALE_META[locale].html} data-edition={section === 'homelab' ? 'homelab' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alts.length > 2 && alts.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {(noindex || !isLive(locale)) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0a09" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <ThemeScript />
    <link rel="icon" href={u(section === 'homelab' ? '/brand/favicon-homelab.svg' : '/brand/favicon-rackdensity.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/icon-512.png')} />
    {section === 'homelab' && <link rel="alternate" type="application/rss+xml" title={`${PRODUCT_NAME} changelog`} href={u('/homelab/changelog.xml')} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:locale" content={LOCALE_META[locale].og} />
    {LOCALES.filter((l) => l !== locale && isLive(l) && isLive(locale) && hasPage(path, l)).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].og} />)}
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}${u(ogImage)}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}${u(ogImage)}`} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {CF_WEB_ANALYTICS_TOKEN && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CF_WEB_ANALYTICS_TOKEN })}></script>}
    {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={`theme-${section}`}>
    {/* Cloudflare's email obfuscation rewrites mailto links to /cdn-cgi/l/email-protection (404 without JS): opt out. */}
    <Fragment set:html="<!--email_off-->" />
    <Header section={section} locale={locale} />
    {bc && <Breadcrumbs items={bc} locale={locale} />}
    {fallback && <p class="fb-note"><span>{t.fallbackNote}</span></p>}
    <main id="main"><slot /></main>
    <Footer section={section} locale={locale} />
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
