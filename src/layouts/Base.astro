---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThemeScript from '../components/site/ThemeScript.astro';
import Breadcrumbs from '../components/site/Breadcrumbs.astro';
import { trail, crumbsSchema, type Crumb } from '../lib/crumbs';
import { ENTITY } from '../config/entity';
import { abs, u } from '../lib/url';
import { BRAND, PRODUCT_NAME, DC_PRODUCT_NAME, SITE_URL, BASE } from '../config/brand';

interface Props {
  title: string;               // full <title>
  description: string;
  path: string;                // route path like '/pricing'
  ogImage?: string;            // path under public, e.g. '/homelab/og/home.png'
  schema?: object[];           // JSON-LD objects for this page
  noindex?: boolean;
  section?: 'hub' | 'homelab';  // drives the header and the theme class (theme-hub / theme-homelab); DC pages use layouts/dc/Base.astro
  crumbs?: Crumb[];             // page crumbs after RACKDENSITY › section (last = this page); omit on section homes
}
const { title, description, path, ogImage = '/og/hub.png', schema = [], noindex = false, section = 'hub', crumbs } = Astro.props;
const bc = crumbs ? trail(section, crumbs) : null;
const ld = bc ? [...schema, crumbsSchema(bc, path)] : schema;
const canonical = abs(path);
const org = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': `${abs('/')}#org`, name: BRAND, url: abs('/'), logo: `${SITE_URL}${u('/icon-512.png')}`,
      description: ENTITY.rackdensity }, // marketing/ENTITY.md, verbatim
    { '@type': 'WebSite', '@id': `${abs('/')}#website`, name: BRAND, url: abs('/'), publisher: { '@id': `${abs('/')}#org` } },
  ],
};
const ogTitle = title.replace(/ \| .*$/, '');
---
<!doctype html>
<html lang="en" data-edition={section === 'homelab' ? 'homelab' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0a09" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <ThemeScript />
    <link rel="icon" href={u(section === 'homelab' ? '/brand/favicon-homelab.svg' : '/brand/favicon-rackdensity.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u('/icon-512.png')} />
    {section === 'homelab' && <link rel="alternate" type="application/rss+xml" title={`${PRODUCT_NAME} changelog`} href={u('/homelab/changelog.xml')} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE_URL}${u(ogImage)}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}${u(ogImage)}`} />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {ld.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class={`theme-${section}`}>
    {/* Cloudflare's email obfuscation rewrites mailto links to /cdn-cgi/l/email-protection (404 without JS): opt out. */}
    <Fragment set:html="<!--email_off-->" />
    <Header section={section} />
    {bc && <Breadcrumbs items={bc} />}
    <main id="main"><slot /></main>
    <Footer section={section} />
    <Fragment set:html="<!--/email_off-->" />
  </body>
</html>
